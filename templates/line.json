{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "x-eas": {
    "template": "line",
    "version": "1.0.0",
    "doc": "One quantitative series over time (or any ordered x), optionally split by a series field.",
    "slots": {
      "data": {"shape": "plist", "required": true, "doc": "rows with an x and a y column"},
      "x": {"type": "field", "of": "data", "default": "date", "doc": "temporal x column"},
      "y": {"type": "field", "of": "data", "default": "value", "doc": "quantitative y column"},
      "title": {"type": "string", "default": ""},
      "description": {"type": "string", "default": "One quantitative series over time (or any ordered x), optionally split by a series field.", "doc": "the takeaway; alt text and table-view fallback (bin/chart check requires it)"},
      "points": {"type": "boolean", "default": false, "doc": "draw a point at every datum"},
      "crosshair": {"type": "boolean", "default": false, "doc": "a rule and point follow the pointer, snapping to the nearest x; the readout lists the tooltip fields"}
    },
    "example": "examples/line.data.json"
  },
  "title": {"x-eas:slot": "title"},
  "description": {"x-eas:slot": "description"},
  "width": "container",
  "height": 200,
  "data": {"name": "data"},
  "layer": [
    {
      "mark": {"type": "line"},
      "encoding": {
        "x": {"field": {"x-eas:slot": "x"}, "type": "temporal"},
        "y": {"field": {"x-eas:slot": "y"}, "type": "quantitative", "scale": {"zero": false}},
        "tooltip": [
          {"field": {"x-eas:slot": "x"}, "type": "temporal"},
          {"field": {"x-eas:slot": "y"}, "type": "quantitative"}
        ]
      }
    },
    {
      "x-eas:when": "points",
      "spec": {
        "mark": {"type": "point", "filled": true},
        "encoding": {
          "x": {"field": {"x-eas:slot": "x"}, "type": "temporal"},
          "y": {"field": {"x-eas:slot": "y"}, "type": "quantitative"}
        }
      }
    },
    {
      "x-eas:when": "crosshair",
      "spec": {
        "name": "crosshair-hit",
        "params": [{"name": "crosshair", "select": {"type": "point", "on": "pointermove", "nearest": true, "encodings": ["x"]}}],
        "mark": {"type": "rule", "opacity": 0},
        "encoding": {"x": {"field": {"x-eas:slot": "x"}, "type": "temporal"}}
      }
    },
    {
      "x-eas:when": "crosshair",
      "spec": {
        "name": "crosshair-rule",
        "transform": [{"filter": {"param": "crosshair", "empty": false}}],
        "mark": {"type": "rule", "color": "gray"},
        "encoding": {"x": {"field": {"x-eas:slot": "x"}, "type": "temporal"}}
      }
    },
    {
      "x-eas:when": "crosshair",
      "spec": {
        "name": "crosshair-point",
        "transform": [{"filter": {"param": "crosshair", "empty": false}}],
        "mark": {"type": "point", "filled": true},
        "encoding": {
          "x": {"field": {"x-eas:slot": "x"}, "type": "temporal"},
          "y": {"field": {"x-eas:slot": "y"}, "type": "quantitative"}
        }
      }
    }
  ]
}
