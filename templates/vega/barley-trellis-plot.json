{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "x-eas": {
    "template": "barley-trellis-plot",
    "aliases": ["vega/barley-trellis-plot"],
    "version": "1.0.0",
    "doc": "Vega gallery barley trellis: one panel per site (by median), a hollow point per variety and year, varieties sorted by median.",
    "slots": {
      "data": {
        "shape": "json",
        "required": true,
        "doc": "rows with a panel (site), a row (variety), a value (yield) and a color group (year)"
      },
      "panel": {
        "type": "field",
        "of": "data",
        "default": "site"
      },
      "row": {
        "type": "field",
        "of": "data",
        "default": "variety"
      },
      "value": {
        "type": "field",
        "of": "data",
        "default": "yield"
      },
      "group": {
        "type": "field",
        "of": "data",
        "default": "year"
      },
      "groupTitle": {
        "type": "string",
        "default": "Year"
      },
      "width": {
        "type": "number",
        "default": 200
      },
      "cellHeight": {
        "type": "number",
        "default": 100
      },
      "spacing": {
        "type": "number",
        "default": 4,
        "doc": "pixels between a panel and the next one's title"
      },
      "title": {
        "type": "string",
        "default": ""
      },
      "description": {
        "type": "string",
        "default": "A small multiples view of barley yields by site and variety.",
        "doc": "the takeaway; alt text and table-view fallback"
      }
    },
    "example": "../examples/vega/barley-trellis-plot.data.json",
    "vega": {
      "example": "barley-trellis-plot",
      "spec": "test/vega-examples/specs/barley-trellis-plot.vg.json",
      "status": "pass",
      "note": "Every panel, point, dashed grid, both side axes and the legend match: the point and x scales round as Vega's (round: true, half up, so alternate panels no longer drift a pixel), the site label sits on its panel's frame (labelPadding 0) with Vega's 115 px panel step, the legend has Vega's padding 4, the x axis keeps all 15 labels (labelOverlap false) and the frame stroke is on the half pixel. Left: Vega's spec leaves 15 px above the first panel where a Vega-Lite facet leaves its header's 12 (eas has no per-side padding), so the chart is 3 px shorter, and the font-raster floor (Helvetica in the reference, Arimo here). Re-measured in eas-7r1.12e (rsvg-convert, Arimo): ratio 0.0479 (was 0.0890; 0.0863 against vg2svg).",
      "ratio": 0.0479,
      "threshold": 0.06,
      "measured": "eas-vega-std-basic oracle, rasterized by rsvg-convert 2.60 (librsvg) with Arimo for Arial/Helvetica (eas-7r1.12)"
    }
  },
  "title": {
    "x-eas:slot": "title"
  },
  "description": {
    "x-eas:slot": "description"
  },
  "data": {
    "name": "data"
  },
  "config": {
    "background": "transparent",
    "view": {
      "stroke": "#ccc"
    },
    "font": "sans-serif",
    "axis": {
      "grid": false,
      "title": null,
      "labelAngle": 0,
      "domainColor": "#888",
      "tickColor": "#888",
      "gridColor": "#ddd",
      "labelColor": "#000",
      "labelFontSize": 10,
      "labelPadding": 2,
      "tickSize": 5,
      "titleColor": "#000",
      "titleFontSize": 11,
      "titleFontWeight": "bold",
      "titlePadding": 4
    },
    "legend": {
      "labelColor": "#000",
      "labelFontSize": 10,
      "titleColor": "#000",
      "titleFontSize": 11,
      "titleFontWeight": "bold",
      "symbolSize": 100
    },
    "bar": {
      "cornerRadiusEnd": 0
    },
    "rect": {
      "strokeWidth": 0
    },
    "arc": {
      "strokeWidth": 0
    },
    "area": {
      "opacity": 1
    },
    "line": {
      "strokeWidth": 1,
      "strokeCap": "butt",
      "strokeJoin": "miter"
    },
    "mark": {
      "color": "#4c78a8"
    },
    "point": {
      "filled": true
    },
    "title": {
      "anchor": "middle",
      "fontSize": 13,
      "fontWeight": "bold",
      "color": "#000"
    },
    "range": {
      "category": [
        "#4c78a8",
        "#f58518",
        "#e45756",
        "#72b7b2",
        "#54a24b",
        "#eeca3b",
        "#b279a2",
        "#ff9da6",
        "#9d755d",
        "#bab0ac"
      ]
    }
  },
  "facet": {
    "field": {
      "x-eas:slot": "panel"
    },
    "type": "nominal",
    "sort": {
      "field": {
        "x-eas:slot": "value"
      },
      "op": "median",
      "order": "descending"
    },
    "header": {
      "title": null,
      "labelFontWeight": "bold",
      "labelFontSize": 11,
      "labelColor": "#000",
      "labelPadding": 0
    }
  },
  "columns": 1,
  "spacing": {
    "x-eas:slot": "spacing"
  },
  "spec": {
    "width": {
      "x-eas:slot": "width"
    },
    "height": {
      "x-eas:slot": "cellHeight"
    },
    "encoding": {
      "x": {
        "field": {
          "x-eas:slot": "value"
        },
        "type": "quantitative",
        "scale": {
          "zero": true,
          "nice": true,
          "round": true
        },
        "axis": {
          "zindex": 1,
          "title": null,
          "tickCount": 10,
          "labelOverlap": false
        }
      },
      "stroke": {
        "field": {
          "x-eas:slot": "group"
        },
        "type": "nominal",
        "legend": {
          "title": {
            "x-eas:slot": "groupTitle"
          },
          "symbolStrokeWidth": 2,
          "symbolSize": 50,
          "padding": 4
        }
      }
    },
    "layer": [
      {
        "mark": {
          "type": "point",
          "filled": false,
          "strokeWidth": 2,
          "size": 50,
          "opacity": 1
        },
        "encoding": {
          "y": {
            "field": {
              "x-eas:slot": "row"
            },
            "type": "nominal",
            "sort": {
              "field": {
                "x-eas:slot": "value"
              },
              "op": "median",
              "order": "descending"
            },
            "scale": {
              "type": "point",
              "padding": 1,
              "round": true
            },
            "axis": {
              "tickSize": 0,
              "domain": false,
              "grid": true,
              "gridDash": [
                3,
                3
              ],
              "title": null
            }
          },
          "tooltip": [
            {
              "field": {
                "x-eas:slot": "panel"
              },
              "type": "nominal"
            },
            {
              "field": {
                "x-eas:slot": "row"
              },
              "type": "nominal"
            },
            {
              "field": {
                "x-eas:slot": "group"
              },
              "type": "nominal"
            },
            {
              "field": {
                "x-eas:slot": "value"
              },
              "type": "quantitative"
            }
          ]
        }
      },
      {
        "mark": {
          "type": "point",
          "opacity": 0
        },
        "encoding": {
          "y": {
            "field": {
              "x-eas:slot": "row"
            },
            "type": "nominal",
            "sort": {
              "field": {
                "x-eas:slot": "value"
              },
              "op": "median",
              "order": "descending"
            },
            "scale": {
              "type": "point",
              "padding": 1,
              "round": true
            },
            "axis": {
              "orient": "right",
              "tickSize": 0,
              "domain": false,
              "title": null
            }
          }
        }
      }
    ],
    "resolve": {
      "axis": {
        "y": "independent"
      }
    }
  }
}
