{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "x-eas": {
    "template": "brushing-scatter-plots",
    "version": "1.0.0",
    "doc": "A 4x4 scatter plot matrix with one brush linked across every cell (Vega gallery: brushing-scatter-plots).",
    "slots": {
      "data": {
        "shape": "plist",
        "required": true,
        "doc": "rows with four quantitative columns and a category"
      },
      "fields": {
        "type": "array",
        "items": "string",
        "default": [
          "Beak Length (mm)",
          "Beak Depth (mm)",
          "Flipper Length (mm)",
          "Body Mass (g)"
        ],
        "doc": "the four quantitative columns, left to right and bottom to top"
      },
      "color": {
        "type": "field",
        "of": "data",
        "default": "Species",
        "doc": "the category column colouring the points"
      },
      "size": {
        "type": "number",
        "default": 120,
        "doc": "width and height of each cell"
      },
      "description": {
        "type": "string",
        "default": "A scatter plot matrix of penguin data with interactive linked selections."
      },
      "title": {
        "type": "string",
        "default": "",
        "doc": "chart title (the gallery example has none)"
      }
    },
    "example": "../examples/vega/brushing-scatter-plots.data.json",
    "vega": {
      "status": "pass",
      "note": "One interval brush shared by the 16 cells (a top-level param with views) greys the points outside it in every cell. Vega lays the cells on a fixed 140px grid; Vega-Lite concatenation spaces rows around their axis labels, so rows sit a few pixels off. Pixel ratio against ref/brushing-scatter-plots.png: 0.051.",
      "ratio": 0.0514,
      "threshold": 0.08
    }
  },
  "title": {
    "x-eas:slot": "title"
  },
  "description": {
    "x-eas:slot": "description"
  },
  "data": {
    "name": "data"
  },
  "transform": [
    {
      "filter": {
        "x-eas:expr": "isValid(datum[{{fields.0}}])"
      }
    }
  ],
  "padding": 10,
  "spacing": 13,
  "params": [
    {
      "name": "brush",
      "views": [
        "cell_0_0",
        "cell_0_1",
        "cell_0_2",
        "cell_0_3",
        "cell_1_0",
        "cell_1_1",
        "cell_1_2",
        "cell_1_3",
        "cell_2_0",
        "cell_2_1",
        "cell_2_2",
        "cell_2_3",
        "cell_3_0",
        "cell_3_1",
        "cell_3_2",
        "cell_3_3"
      ],
      "select": {
        "type": "interval",
        "resolve": "global",
        "mark": {
          "fill": "#eee",
          "fillOpacity": 1,
          "strokeOpacity": 0
        }
      }
    }
  ],
  "config": {
    "background": "transparent",
    "font": "sans-serif",
    "view": {
      "stroke": "#ddd"
    },
    "range": {
      "category": [
        "#4c78a8",
        "#f58518",
        "#e45756",
        "#72b7b2",
        "#54a24b",
        "#eeca3b",
        "#b279a2",
        "#ff9da6",
        "#9d755d",
        "#bab0ac"
      ]
    },
    "axis": {
      "domainColor": "#888",
      "tickColor": "#ccc",
      "labelColor": "#000",
      "labelFontSize": 10,
      "labelPadding": 2,
      "tickSize": 5,
      "grid": false,
      "titleColor": "#000",
      "titleFontSize": 11,
      "titleFontWeight": "bold",
      "titlePadding": 4
    },
    "legend": {
      "labelColor": "#000",
      "labelFontSize": 10,
      "titleColor": "#000",
      "titleFontSize": 11,
      "titleFontWeight": "bold",
      "symbolSize": 100,
      "symbolType": "circle"
    }
  },
  "vconcat": [
    {
      "bounds": "flush",
      "spacing": 20,
      "hconcat": [
        {
          "name": "cell_0_0",
          "width": {
            "x-eas:slot": "size"
          },
          "height": {
            "x-eas:slot": "size"
          },
          "mark": {
            "type": "point",
