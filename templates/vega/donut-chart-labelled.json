{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "x-eas": {
    "template": "donut-chart-labelled",
    "namespace": "vega",
    "version": "1.0.0",
    "doc": "Vega gallery labelled donut: wedges in data order, each labelled beside the ring with a leader line; labels on a side never overlap.",
    "slots": {
      "data": {
        "shape": "json",
        "required": true,
        "doc": "rows with an id (the label) and a value"
      },
      "id": {
        "type": "field",
        "of": "data",
        "default": "id"
      },
      "value": {
        "type": "field",
        "of": "data",
        "default": "value"
      },
      "innerRadius": {
        "type": "number",
        "default": 60
      },
      "outerRadius": {
        "type": "number",
        "default": 100
      },
      "labelFontSize": {
        "type": "number",
        "default": 12
      },
      "separate": {
        "type": "boolean",
        "default": true,
        "doc": "push labels apart; false leaves each beside its wedge, as Vega's static render shows"
      },
      "scheme": {
        "type": "string",
        "default": "category20"
      },
      "size": {
        "type": "number",
        "default": 200,
        "doc": "width and height of the donut's square"
      },
      "title": {
        "type": "string",
        "default": ""
      },
      "description": {
        "type": "string",
        "default": "Donut with non-overlapping labels.",
        "doc": "the takeaway; alt text and table-view fallback"
      }
    },
    "example": "../examples/vega/donut-chart-labelled.data.json",
    "vega": {
      "example": "donut-chart-labelled",
      "spec": "test/vega-examples/specs/donut-chart-labelled.vg.json",
      "status": "pass",
      "note": "The arc-label transform draws the leader lines and keeps labels apart; the reference is Vega's pre-animation frame, in which three labels still overlap (separate: false reproduces it). Against the vg2png (node-canvas) reference, re-measured in eas-7r1.12 with rsvg-convert and Arimo: ratio 0.0160 (was 0.016 against vg2svg).",
      "ratio": 0.016,
      "threshold": 0.05,
      "measured": "eas-vega-std-basic oracle, rasterized by rsvg-convert 2.60 (librsvg) with Arimo for Arial/Helvetica (eas-7r1.12)"
    }
  },
  "title": {
    "x-eas:slot": "title"
  },
  "description": {
    "x-eas:slot": "description"
  },
  "width": {
    "x-eas:slot": "size"
  },
  "height": {
    "x-eas:slot": "size"
  },
  "padding": 30,
  "data": {
    "name": "data"
  },
  "config": {
    "background": "transparent",
    "view": {
      "stroke": null
    },
    "font": "sans-serif",
    "axis": {
      "grid": false,
      "title": null,
      "labelAngle": 0,
      "domainColor": "#888",
      "tickColor": "#888",
      "gridColor": "#ddd",
      "labelColor": "#000",
      "labelFontSize": 10,
      "labelPadding": 2,
      "tickSize": 5,
      "titleColor": "#000",
      "titleFontSize": 11,
      "titleFontWeight": "bold",
      "titlePadding": 4
    },
    "legend": {
      "labelColor": "#000",
      "labelFontSize": 10,
      "titleColor": "#000",
      "titleFontSize": 11,
      "titleFontWeight": "bold",
      "symbolSize": 100
    },
    "bar": {
      "cornerRadiusEnd": 0
    },
    "rect": {
      "strokeWidth": 0
    },
    "arc": {
      "strokeWidth": 0
    },
    "area": {
      "opacity": 1
    },
    "line": {
      "strokeWidth": 1,
      "strokeCap": "butt",
      "strokeJoin": "miter"
    },
    "mark": {
      "color": "#4c78a8"
    },
    "point": {
      "filled": true
    },
    "title": {
      "anchor": "middle",
      "fontSize": 13,
      "fontWeight": "bold",
      "color": "#000"
    },
    "range": {
      "category": [
        "#4c78a8",
        "#f58518",
        "#e45756",
        "#72b7b2",
        "#54a24b",
        "#eeca3b",
        "#b279a2",
        "#ff9da6",
        "#9d755d",
        "#bab0ac"
      ]
    }
  },
  "transform": [
    {
      "x-eas:transform": "arc-label",
      "field": {
        "x-eas:slot": "value"
      },
      "width": {
        "x-eas:slot": "size"
      },
      "outerRadius": {
        "x-eas:slot": "outerRadius"
      },
      "labelHeight": {
        "x-eas:slot": "labelFontSize"
      },
      "separate": {
        "x-eas:slot": "separate"
      }
    },
    {
      "window": [
        {
          "op": "row_number",
          "as": "x-eas-order"
        }
      ]
    }
  ],
  "layer": [
    {
      "mark": {
        "type": "arc",
        "innerRadius": {
          "x-eas:slot": "innerRadius"
        },
        "outerRadius": {
          "x-eas:slot": "outerRadius"
        },
        "stroke": "white",
        "strokeWidth": 1
      },
      "encoding": {
        "theta": {
          "field": {
            "x-eas:slot": "value"
          },
          "type": "quantitative",
          "stack": true
        },
        "color": {
          "field": {
            "x-eas:slot": "id"
          },
          "type": "nominal",
          "sort": null,
          "legend": null,
          "scale": {
            "scheme": {
              "x-eas:slot": "scheme"
            }
          }
        },
        "order": {
          "field": "x-eas-order",
          "type": "quantitative"
        },
        "tooltip": [
          {
            "field": {
              "x-eas:slot": "id"
            },
            "type": "nominal"
          },
          {
            "field": {
              "x-eas:slot": "value"
            },
            "type": "quantitative"
          }
        ]
      }
    },
    {
      "mark": {
        "type": "rule",
        "color": "grey",
        "strokeWidth": 1,
        "opacity": 0.7
      },
      "encoding": {
        "x": {
          "type": "quantitative",
          "axis": null,
          "scale": {
            "domain": [
              0,
              {
                "x-eas:slot": "size"
              }
            ],
            "nice": false,
            "zero": false
          },
          "field": "arc_x1"
        },
        "y": {
          "type": "quantitative",
          "axis": null,
          "scale": {
            "domain": [
              0,
              {
                "x-eas:slot": "size"
              }
            ],
            "nice": false,
            "zero": false,
            "reverse": true
          },
          "field": "arc_y1"
        },
        "x2": {
          "field": "arc_x2"
        },
        "y2": {
          "field": "arc_y2"
        }
      }
    },
    {
      "mark": {
        "type": "rule",
        "color": "grey",
        "strokeWidth": 1,
        "opacity": 0.7
      },
      "encoding": {
        "x": {
          "type": "quantitative",
          "axis": null,
          "scale": {
            "domain": [
              0,
              {
                "x-eas:slot": "size"
              }
            ],
            "nice": false,
            "zero": false
          },
          "field": "arc_x2"
        },
        "y": {
          "type": "quantitative",
          "axis": null,
          "scale": {
            "domain": [
              0,
              {
                "x-eas:slot": "size"
              }
            ],
            "nice": false,
            "zero": false,
            "reverse": true
          },
          "field": "arc_y2"
        },
        "x2": {
          "field": "arc_x3"
        },
        "y2": {
          "field": "arc_y2"
        }
      }
    },
    {
      "mark": {
        "type": "rule",
        "color": "grey",
        "strokeWidth": 1,
        "opacity": 0.7
      },
      "encoding": {
        "x": {
          "type": "quantitative",
          "axis": null,
          "scale": {
            "domain": [
              0,
              {
                "x-eas:slot": "size"
              }
            ],
            "nice": false,
            "zero": false
          },
          "field": "arc_x3"
        },
        "y": {
          "type": "quantitative",
          "axis": null,
          "scale": {
            "domain": [
              0,
              {
                "x-eas:slot": "size"
              }
            ],
            "nice": false,
            "zero": false,
            "reverse": true
          },
          "field": "arc_y2"
        },
        "x2": {
          "field": "arc_x4"
        },
        "y2": {
          "field": "arc_y4"
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum['arc_side'] == 'right'"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "middle",
        "dx": 3,
        "color": "black",
        "opacity": 0.6,
        "fontSize": {
          "x-eas:slot": "labelFontSize"
        }
      },
      "encoding": {
        "x": {
          "type": "quantitative",
          "axis": null,
          "scale": {
            "domain": [
              0,
              {
                "x-eas:slot": "size"
              }
            ],
            "nice": false,
            "zero": false
          },
          "field": "arc_x4"
        },
        "y": {
          "type": "quantitative",
          "axis": null,
          "scale": {
            "domain": [
              0,
              {
                "x-eas:slot": "size"
              }
            ],
            "nice": false,
            "zero": false,
            "reverse": true
          },
          "field": "arc_y4"
        },
        "text": {
          "field": {
            "x-eas:slot": "id"
          },
          "type": "nominal"
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum['arc_side'] == 'left'"
        }
      ],
      "mark": {
        "type": "text",
        "align": "right",
        "baseline": "middle",
        "dx": -3,
        "color": "black",
        "opacity": 0.6,
        "fontSize": {
          "x-eas:slot": "labelFontSize"
        }
      },
      "encoding": {
        "x": {
          "type": "quantitative",
          "axis": null,
          "scale": {
            "domain": [
              0,
              {
                "x-eas:slot": "size"
              }
            ],
            "nice": false,
            "zero": false
          },
          "field": "arc_x4"
        },
        "y": {
          "type": "quantitative",
          "axis": null,
          "scale": {
            "domain": [
              0,
              {
                "x-eas:slot": "size"
              }
            ],
            "nice": false,
            "zero": false,
            "reverse": true
          },
          "field": "arc_y4"
        },
        "text": {
          "field": {
            "x-eas:slot": "id"
          },
          "type": "nominal"
        }
      }
    }
  ]
}
