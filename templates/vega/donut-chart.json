{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "x-eas": {
    "template": "donut-chart",
    "aliases": ["vega/donut-chart"],
    "version": "1.0.0",
    "doc": "Vega gallery donut chart: one wedge per row, sized by value, around a hole.",
    "slots": {
      "data": {
        "shape": "json",
        "required": true,
        "doc": "rows with an id and a value"
      },
      "id": {
        "type": "field",
        "of": "data",
        "default": "id"
      },
      "value": {
        "type": "field",
        "of": "data",
        "default": "field"
      },
      "startAngle": {
        "type": "number",
        "default": 0,
        "doc": "radians, clockwise from 12 o'clock"
      },
      "endAngle": {
        "type": "number",
        "default": 6.283185307179586
      },
      "innerRadius": {
        "type": "number",
        "default": 60
      },
      "outerRadius": {
        "type": "number",
        "default": 100
      },
      "padAngle": {
        "type": "number",
        "default": 0
      },
      "cornerRadius": {
        "type": "number",
        "default": 0
      },
      "scheme": {
        "type": "string",
        "default": "category20"
      },
      "size": {
        "type": "number",
        "default": 200,
        "doc": "width and height"
      },
      "title": {
        "type": "string",
        "default": ""
      },
      "description": {
        "type": "string",
        "default": "A basic donut chart example.",
        "doc": "the takeaway; alt text and table-view fallback"
      }
    },
    "example": "../examples/vega/donut-chart.data.json",
    "vega": {
      "example": "donut-chart",
      "spec": "test/vega-examples/specs/donut-chart.vg.json",
      "status": "pass",
      "note": "As pie-chart with innerRadius 60. Against the vg2png (node-canvas) reference, re-measured in eas-7r1.12 with rsvg-convert and Arimo: ratio 0.0028 (was 0.0031 against vg2svg).",
      "ratio": 0.0028,
      "threshold": 0.05,
      "measured": "eas-vega-std-basic oracle, rasterized by rsvg-convert 2.60 (librsvg) with Arimo for Arial/Helvetica (eas-7r1.12)"
    }
  },
  "title": {
    "x-eas:slot": "title"
  },
  "description": {
    "x-eas:slot": "description"
  },
  "width": {
    "x-eas:slot": "size"
  },
  "height": {
    "x-eas:slot": "size"
  },
  "padding": 0,
  "data": {
    "name": "data"
  },
  "config": {
    "background": "transparent",
    "view": {
      "stroke": null
    },
    "font": "sans-serif",
    "axis": {
      "grid": false,
      "title": null,
      "labelAngle": 0,
      "domainColor": "#888",
      "tickColor": "#888",
      "gridColor": "#ddd",
      "labelColor": "#000",
      "labelFontSize": 10,
      "labelPadding": 2,
      "tickSize": 5,
      "titleColor": "#000",
      "titleFontSize": 11,
      "titleFontWeight": "bold",
      "titlePadding": 4
    },
    "legend": {
      "labelColor": "#000",
      "labelFontSize": 10,
      "titleColor": "#000",
      "titleFontSize": 11,
      "titleFontWeight": "bold",
      "symbolSize": 100
    },
    "bar": {
      "cornerRadiusEnd": 0
    },
    "rect": {
      "strokeWidth": 0
    },
    "arc": {
      "strokeWidth": 0
    },
    "area": {
      "opacity": 1
    },
    "line": {
      "strokeWidth": 1,
      "strokeCap": "butt",
      "strokeJoin": "miter"
    },
    "mark": {
      "color": "#4c78a8"
    },
    "point": {
      "filled": true
    },
    "title": {
      "anchor": "middle",
      "fontSize": 13,
      "fontWeight": "bold",
      "color": "#000"
    },
    "range": {
      "category": [
        "#4c78a8",
        "#f58518",
        "#e45756",
        "#72b7b2",
        "#54a24b",
        "#eeca3b",
        "#b279a2",
        "#ff9da6",
        "#9d755d",
        "#bab0ac"
      ]
    }
  },
  "mark": {
    "type": "arc",
    "innerRadius": {
      "x-eas:slot": "innerRadius"
    },
    "outerRadius": {
      "x-eas:slot": "outerRadius"
    },
    "padAngle": {
      "x-eas:slot": "padAngle"
    },
    "cornerRadius": {
      "x-eas:slot": "cornerRadius"
    }
  },
  "encoding": {
    "theta": {
      "field": {
        "x-eas:slot": "value"
      },
      "type": "quantitative",
      "stack": true,
      "scale": {
        "range": [
          {
            "x-eas:slot": "startAngle"
          },
          {
            "x-eas:slot": "endAngle"
          }
        ]
      }
    },
    "color": {
      "field": {
        "x-eas:slot": "id"
      },
      "type": "nominal",
      "sort": null,
      "legend": null,
      "scale": {
        "scheme": {
          "x-eas:slot": "scheme"
        }
      }
    },
    "order": {
      "field": "x-eas-order",
      "type": "quantitative"
    },
    "tooltip": [
      {
        "field": {
          "x-eas:slot": "id"
        },
        "type": "nominal"
      },
      {
        "field": {
          "x-eas:slot": "value"
        },
        "type": "quantitative"
      }
    ]
  },
  "transform": [
    {
      "window": [
        {
          "op": "row_number",
          "as": "x-eas-order"
        }
      ]
    }
  ]
}
