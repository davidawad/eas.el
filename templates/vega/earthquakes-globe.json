{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "x-eas": {
    "template": "earthquakes-globe",
    "aliases": ["vega/earthquakes-globe"],
    "version": "1.0.0",
    "doc": "Point events as rings on a dark orthographic globe among stars, colored and sized by magnitude; the globe's rotation is bound to an input.",
    "slots": {
      "world": {"shape": "geojson", "required": true, "doc": "country shapes: GeoJSON features, or TopoJSON {\"url\" or \"topology\", \"feature\"}"},
      "quakes": {"shape": "geojson", "required": true, "doc": "the events: GeoJSON point features or rows (a FeatureCollection, or {\"url\": F})"},
      "longitude": {"type": "string", "default": "geometry.coordinates[0]", "doc": "path of an event's longitude in its row"},
      "latitude": {"type": "string", "default": "geometry.coordinates[1]", "doc": "path of an event's latitude in its row"},
      "magnitude": {"type": "string", "default": "properties.mag", "doc": "path of an event's magnitude in its row"},
      "angle": {"type": "number", "default": 0, "doc": "the globe's rotation, degrees (Vega's globeRotationAngle; its timer steps it by one)"},
      "scale": {"type": "number", "default": 225, "doc": "the globe's scale"},
      "circle_size": {"type": "number", "default": 1.8, "doc": "radius in pixels of a magnitude ln(100) event"},
      "size": {"type": "number", "default": 600, "doc": "width and height"},
      "title": {"type": "string", "default": "Earthquakes with magnitude 2.5+, last 30 days (live feed)"},
      "subtitle": {"type": "string", "default": "Click anywhere to pause/resume rotation"},
      "description": {"type": "string", "default": "Rotating globe animation depicting earthquake locations. Background - pseudorandomly distributed 'stars'.", "doc": "the takeaway; alt text and table-view fallback"}
    },
    "example": "../examples/vega/earthquakes-globe.data.json",
    "timer": {"interval": 100},
    "on": [{"events": "timer", "param": "angle", "update": "paused ? angle : (angle <= -180 ? 180 : angle - 1)"},
           {"events": ["key:space", "key:p"], "param": "paused", "update": "!paused"}],
    "vega": {
      "status": "partial",
      "note": "the globe (orthographic, #000022 sphere, translucent white countries), the magnitude rings (stroke colored on Vega's 8-color linear scale, radius circle_size * sqrt(exp(mag) / 100), width 1 + 0.15 r, far side filtered as the circle clip hides it), the Tahoma title, subtitle and legend title (sans-serif where Tahoma is missing), the one symbol legend of magnitudes 1-9 sized and colored as the rings (a size and a color of one field merge, as in Vega-Lite) and the rotation (x-eas.timer every 100 ms turns the globe a degree, 180 after -180, as Vega's timer signal) match. Not reproduced: the stars' positions (random() in Vega), the sphere's gradient stroke (eas paints gradients on fills only; drawn in its midpoint color, invisible at opacity 0.3), click-to-pause (space or p pauses: x-eas.on has no click event), and Vega's legend layout, which is a Vega quirk: its symbol size and stroke width encodes leave the entries' symbol and label positions NaN, so canvas draws every symbol and label at its entry's origin and stacks rows on symbol bounds grown by the miter limit (r + 2 strokeWidth). Against the vg2png (node-canvas) reference, re-measured in eas-7r1.12b with rsvg-convert and Arimo: ratio 0.0170, of which the Tahoma title and subtitle drawn in Arimo are 0.009, the legend 0.006, the stars 0.002 and the globe 0.0017.",
      "ratio": 0.017,
      "threshold": 0.03
    }
  },
  "title": {"text": {"x-eas:slot": "title"}, "subtitle": {"x-eas:slot": "subtitle"}, "anchor": "start", "font": "Tahoma, sans-serif", "subtitleFont": "Tahoma, sans-serif",
            "color": "#dddddd", "fontSize": 18, "fontWeight": "normal", "subtitleColor": "#888888", "subtitlePadding": 5, "offset": 4, "dy": -10},
  "description": {"x-eas:slot": "description"},
  "width": {"x-eas:slot": "size"},
  "height": {"x-eas:slot": "size"},
  "padding": 5,
  "background": "#000000",
  "config": {"legend": {"titleColor": "#dddddd", "labelColor": "#dddddd"}},
  "params": [
    {"name": "angle", "value": {"x-eas:slot": "angle"}, "bind": {"input": "range", "min": -180, "max": 180, "step": 1}},
    {"name": "circleSize", "value": {"x-eas:slot": "circle_size"}},
    {"name": "paused", "value": false}
  ],
  "layer": [
    {
      "data": {"sequence": {"start": 1, "stop": 201, "as": "star"}},
      "transform": [
        {"calculate": {"x-eas:expr": "ceil(random() * {{size}})"}, "as": "sx"},
        {"calculate": {"x-eas:expr": "ceil((datum.star * 7919 + datum.sx * 104729) % {{size}})"}, "as": "sy"},
        {"calculate": "datum.sx < 60 && datum.sy < 200 ? 0 : ceil(random() * 1.5)", "as": "area"}
      ],
      "encoding": {
        "x": {"field": "sx", "type": "quantitative", "axis": null,
              "scale": {"domain": [0, {"x-eas:slot": "size"}], "nice": false, "zero": false}},
        "y": {"field": "sy", "type": "quantitative", "axis": null,
              "scale": {"domain": [{"x-eas:slot": "size"}, 0], "nice": false, "zero": false}}
      },
      "layer": [
        {"transform": [{"filter": "datum.area == 1"}], "mark": {"type": "circle", "color": "white", "opacity": 1, "size": 1}},
        {"transform": [{"filter": "datum.area == 2"}], "mark": {"type": "circle", "color": "white", "opacity": 1, "size": 2}}
      ]
    },
    {
      "projection": {"type": "orthographic", "scale": {"x-eas:slot": "scale"}, "rotate": {"expr": "[-angle, 0, 0]"}},
      "layer": [
        {
          "data": {"sphere": true},
          "mark": {"type": "geoshape", "fill": "#000022", "fillOpacity": 1, "stroke": "#3333ff", "strokeWidth": 8, "strokeOpacity": 0.3}
        },
        {
          "data": {"name": "world"},
          "mark": {"type": "geoshape", "fill": "white", "fillOpacity": 0.1, "stroke": "white", "strokeWidth": 0.2}
        },
        {
          "data": {"name": "quakes"},
          "transform": [
            {"calculate": {"x-eas:text": "datum.{{longitude}}"}, "as": "lon"},
            {"calculate": {"x-eas:text": "datum.{{latitude}}"}, "as": "lat"},
            {"calculate": {"x-eas:text": "datum.{{magnitude}}"}, "as": "Magnitude"},
            {"filter": "cos((datum.lon - angle) * PI / 180) * cos(datum.lat * PI / 180) > 0"},
            {"calculate": "circleSize * sqrt(exp(datum.Magnitude) / 100)", "as": "r"},
            {"calculate": "PI * datum.r * datum.r", "as": "area"},
            {"calculate": "1 + datum.r * 0.15", "as": "width"}
          ],
          "mark": {"type": "circle", "filled": false, "opacity": 1, "fillOpacity": 0},
          "encoding": {
            "longitude": {"field": "lon", "type": "quantitative"},
            "latitude": {"field": "lat", "type": "quantitative"},
            "stroke": {"field": "Magnitude", "type": "quantitative",
                       "scale": {"domain": [1.9, 2.9, 3.9, 4.9, 5.9, 6.9, 7.9, 8.9],
                                 "range": ["#afeeee", "#98fb98", "#adff2f", "#ffff00", "#ffd700", "#ff8c00", "#ff0000", "#800000"]},
                       "legend": {"orient": "left", "offset": -50, "title": "Magnitude", "titleFont": "Tahoma, sans-serif", "values": [1, 2, 3, 4, 5, 6, 7, 8, 9],
                                  "titleFontSize": 14, "labelFontSize": 13}},
            "size": {"field": "Magnitude", "type": "quantitative",
                     "scale": {"type": "linear", "domain": [1, 2, 3, 4, 5, 6, 7, 8, 9],
                               "range": [{"expr": "PI * circleSize * circleSize * exp(1) / 100"}, {"expr": "PI * circleSize * circleSize * exp(2) / 100"}, {"expr": "PI * circleSize * circleSize * exp(3) / 100"}, {"expr": "PI * circleSize * circleSize * exp(4) / 100"}, {"expr": "PI * circleSize * circleSize * exp(5) / 100"}, {"expr": "PI * circleSize * circleSize * exp(6) / 100"}, {"expr": "PI * circleSize * circleSize * exp(7) / 100"}, {"expr": "PI * circleSize * circleSize * exp(8) / 100"}, {"expr": "PI * circleSize * circleSize * exp(9) / 100"}]}},
            "strokeWidth": {"field": "width", "type": "quantitative", "legend": null,
                            "scale": {"type": "linear", "domain": [0, 1], "range": [0, 1]}},
            "tooltip": [{"field": "Magnitude", "type": "quantitative"}]
          }
        }
      ]
    }
  ]
}
