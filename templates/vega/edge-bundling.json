            },
            "extent": {
              "x-eas:slot": "extent"
            },
            "radius": {
              "x-eas:slot": "radius"
            },
            "width": {
              "x-eas:slot": "width"
            },
            "height": {
              "x-eas:slot": "height"
            }
          }
        },
        {
          "x-eas:transform": "formula",
          "expr": "datum.leftside ? datum.angle - 180 : datum.angle",
          "as": "labelAngle",
          "params": {
            "rotate": {
              "x-eas:slot": "rotate"
            },
            "extent": {
              "x-eas:slot": "extent"
            },
            "radius": {
              "x-eas:slot": "radius"
            },
            "width": {
              "x-eas:slot": "width"
            },
            "height": {
              "x-eas:slot": "height"
            }
          }
        },
        {
          "x-eas:transform": "formula",
          "expr": "datum.x + textOffset * cos(PI * datum.angle / 180)",
          "as": "labelX",
          "params": {
            "rotate": {
              "x-eas:slot": "rotate"
            },
            "extent": {
              "x-eas:slot": "extent"
            },
            "radius": {
              "x-eas:slot": "radius"
            },
            "width": {
              "x-eas:slot": "width"
            },
            "height": {
              "x-eas:slot": "height"
            },
            "textOffset": {
              "x-eas:slot": "textOffset"
            }
          }
        },
        {
