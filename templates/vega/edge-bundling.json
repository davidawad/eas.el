          },
          "parentKey": {
            "x-eas:slot": "parent"
          },
          "method": {
            "x-eas:slot": "method"
          },
          "size": [
            1,
            1
          ],
          "as": [
            "alpha",
            "beta",
            "depth",
            "children"
          ]
        },
        {
          "x-eas:transform": "formula",
          "expr": "(rotate + extent * datum.alpha + 270) % 360",
          "as": "angle",
          "params": {
            "rotate": {
              "x-eas:slot": "rotate"
            },
            "extent": {
              "x-eas:slot": "extent"
            },
            "radius": {
