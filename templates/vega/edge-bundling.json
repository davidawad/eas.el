{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "x-eas": {
    "template": "edge-bundling",
    "namespace": "vega",
    "version": "1.0.0",
    "doc": "Hierarchical edge bundling: the leaves of an id/parent tree on a circle, and each source-target link drawn along the tree path between its ends, bundled.",
    "slots": {
      "data": {
        "shape": "plist",
        "required": true,
        "doc": "one row per tree node: a key, the parent's key (null at the root) and a label"
      },
      "links": {
        "shape": "plist",
        "required": true,
        "doc": "one row per link between two node keys"
      },
      "key": {
        "type": "field",
        "of": "data",
        "default": "id"
      },
      "parent": {
        "type": "field",
        "of": "data",
        "default": "parent",
        "doc": "the parent's key; exactly one row has none"
      },
      "label": {
        "type": "field",
        "of": "data",
        "default": "name"
      },
      "source": {
        "type": "field",
        "of": "links",
        "default": "source"
      },
      "target": {
        "type": "field",
        "of": "links",
        "default": "target"
      },
      "method": {
        "enum": [
          "tidy",
          "cluster"
        ],
        "default": "cluster"
      },
      "tension": {
        "type": "number",
        "default": 0.85,
        "doc": "bundle strength, 0 (straight) to 1 (along the tree)"
      },
      "radius": {
        "type": "number",
        "default": 280
      },
      "extent": {
        "type": "number",
        "default": 360
      },
      "rotate": {
        "type": "number",
        "default": 0
      },
      "textSize": {
        "type": "number",
        "default": 8
      },
      "textOffset": {
        "type": "number",
        "default": 2
      },
      "colorIn": {
        "type": "string",
        "default": "firebrick"
      },
      "colorOut": {
        "type": "string",
        "default": "forestgreen"
      },
      "width": {
        "type": "number",
        "default": 720
      },
      "height": {
        "type": "number",
        "default": 720
      },
      "title": {
        "type": "string",
        "default": ""
      },
      "description": {
        "type": "string",
        "default": "Hierarchical edge bundling: links between leaves follow their tree path, so related links bundle together."
      }
    },
    "example": "../examples/vega/edge-bundling.data.json",
    "vega": {
      "status": "partial",
      "note": "Bundled links and leaf labels match Vega. Hovering a label draws its links in colorOut/colorIn as Vega does, but the linked labels are not bolded or recolored (Vega's indata tests), and the tension, radius, extent, rotate, text and layout widgets are slots. Against the vg2png (node-canvas) reference, re-measured in eas-7r1.12 with rsvg-convert and Arimo: ratio 0.0350 (was 0.02 against vg2svg); geometry matches; the rest is the font-raster floor: the references' sans-serif is Helvetica (node-canvas on macOS), native SVG here is drawn in Arimo (Arial metrics), so glyph edges differ while positions match.",
      "ratio": 0.035
    }
  },
  "title": {
    "x-eas:slot": "title"
  },
  "description": {
    "x-eas:slot": "description"
  },
  "width": {
    "x-eas:slot": "width"
  },
  "height": {
    "x-eas:slot": "height"
  },
  "padding": 5,
  "config": {
    "view": {
      "stroke": null
    },
    "legend": {
      "titleFontWeight": "bold",
      "titleColor": "#000",
      "labelColor": "#000",
      "labelFontSize": 10,
      "titleFontSize": 11
    }
  },
  "layer": [
    {
      "data": {
        "name": "data"
      },
      "transform": [
        {
          "x-eas:transform": "tree",
