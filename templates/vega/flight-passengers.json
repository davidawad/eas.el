{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "x-eas": {
    "template": "flight-passengers",
    "namespace": "vega",
    "version": "1.0.0",
    "doc": "Year-over-year change: a line with points of the relative change from a prior value, a dashed zero line, signed percent labels.",
    "slots": {
      "data": {
        "shape": "plist",
        "required": true,
        "doc": "monthly rows with a date, the current value and the prior year's value"
      },
      "date": {"type": "field", "of": "data", "default": "date", "doc": "month (ISO date)"},
      "current": {"type": "field", "of": "data", "default": "curr", "doc": "this year's value"},
      "prior": {"type": "field", "of": "data", "default": "prev", "doc": "the prior year's value"},
      "yTitle": {"type": "string", "default": "Change from Prior Year"},
      "title": {"type": "string", "default": ""},
      "subtitle": {"type": "string", "default": ""},
      "description": {
        "type": "string",
        "default": "Change from the prior year, month by month.",
        "doc": "the takeaway; alt text and table-view fallback"
      }
    },
    "example": "../examples/vega/flight-passengers.data.json",
    "vega": {
      "status": "pass",
      "note": "Line, points, signed percent axis and the dashed zero line match. The zero line is Vega's: the 0 grid line drawn #888 and dashed by conditional gridColor and gridDash (crisp on the half pixel, under the line), not a rule mark; the title room is Vega's union of title and subtitle bounds, so the plot is no longer 2 px shorter. What remains is the font-raster floor (Helvetica in the reference, Arimo here). Re-measured in eas-7r1.12e (rsvg-convert, Arimo): ratio 0.0236 (was 0.0477; 0.0615 against vg2svg).",
      "size": [
        500,
        250
      ],
      "ratio": 0.0236, "threshold": 0.03
    }
  },
  "title": {
    "text": {"x-eas:slot": "title"},
    "subtitle": {"x-eas:slot": "subtitle"},
    "subtitleFontStyle": "italic",
    "subtitlePadding": 5,
    "frame": "bounds",
    "anchor": "start",
    "offset": 12,
    "fontSize": 13,
    "fontWeight": "bold"
  },
  "description": {"x-eas:slot": "description"},
  "width": "container",
  "height": "container",
  "autosize": {"type": "fit", "contains": "padding"},
  "background": "#fff",
  "padding": 5,
  "data": {"name": "data"},
  "transform": [
    {"calculate": {"x-eas:expr": "toDate(datum[{{date}}])"}, "as": "_t"},
    {"timeUnit": "yearmonth", "field": "_t", "as": "month"},
    {"calculate": {"x-eas:expr": "datum[{{current}}] / datum[{{prior}}] - 1"}, "as": "change"}
  ],
  "layer": [
    {
      "encoding": {
        "x": {
          "field": "month",
          "type": "temporal",
          "title": null,
          "scale": {"padding": 24},
          "axis": {
            "format": "%b %Y",
            "labelPadding": 10,
            "grid": false,
            "labelFlush": false,
            "labelOverlap": false,
            "zindex": 1
          }
        },
        "y": {
          "field": "change",
          "type": "quantitative",
          "scale": {"nice": true, "zero": true},
          "axis": {
            "format": "+%",
            "grid": true,
            "tickCount": 5,
            "labelOverlap": false,
            "gridColor": {"condition": {"test": "datum.value === 0", "value": "#888"}, "value": "#eee"},
            "gridDash": {"condition": {"test": "datum.value === 0", "value": [5, 4]}, "value": []},
            "title": {"x-eas:slot": "yTitle"},
            "titleAlign": "left",
            "titleAngle": 0,
            "titleAnchor": "end",
            "titleBaseline": "middle",
            "titleFontSize": 10,
            "titleFontWeight": "normal",
            "titleX": 1,
            "titleY": 0,
            "labelExpr": "datum.value ? datum.label : ''"
          }
        }
      },
      "layer": [
        {"mark": {"type": "line", "stroke": "steelblue", "strokeWidth": 3}},
        {
          "mark": {
            "type": "point",
            "shape": "circle",
            "filled": true,
            "fill": "steelblue",
            "opacity": 1,
            "size": 64
          }
        }
      ]
    }
  ],
  "config": {
    "background": "white",
    "font": "sans-serif",
    "arc": {"stroke": null},
    "area": {"opacity": 1},
    "axis": {
      "domainColor": "#888",
      "gridColor": "#ddd",
      "labelColor": "#555",
      "labelFontSize": 10,
      "labelPadding": 2,
      "tickColor": "#888",
      "tickSize": 5,
      "titleColor": "#555",
      "titleFontSize": 11,
      "titleFontWeight": "bold",
      "titlePadding": 4,
      "domain": false,
      "ticks": false
    },
    "bar": {"cornerRadiusEnd": 0},
    "legend": {
      "labelColor": "#000",
      "labelFontSize": 10,
      "symbolSize": 100,
      "symbolType": "circle",
      "titleColor": "#000",
      "titleFontSize": 11,
      "titleFontWeight": "bold"
    },
    "line": {"strokeCap": "butt", "strokeJoin": "miter"},
    "mark": {"color": "#4c78a8"},
    "point": {"filled": false, "size": 30},
    "circle": {"size": 30},
    "range": {
      "category": ["#4c78a8", "#f58518", "#e45756", "#72b7b2", "#54a24b", "#eeca3b", "#b279a2", "#ff9da6", "#9d755d", "#bab0ac"]
    },
    "rect": {"stroke": null},
    "title": {
      "anchor": "middle",
      "color": "#000",
      "fontSize": 13,
      "fontWeight": "bold",
      "offset": 4,
      "subtitleColor": "#000",
      "subtitleFontSize": 12
    },
    "view": {"stroke": null}
  }
}
