{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "x-eas": {
    "template": "grouped-bar-chart",
    "namespace": "vega",
    "version": "1.0.0",
    "doc": "Vega gallery grouped bar chart: horizontal bars per category, one per position within it, each labelled with its value.",
    "slots": {
      "data": {
        "shape": "json",
        "required": true,
        "doc": "rows with a category, a position within it and a value"
      },
      "category": {
        "type": "field",
        "of": "data",
        "default": "category"
      },
      "position": {
        "type": "field",
        "of": "data",
        "default": "position"
      },
      "value": {
        "type": "field",
        "of": "data",
        "default": "value"
      },
      "scheme": {
        "type": "string",
        "default": "category20"
      },
      "labelColors": {
        "type": "array",
        "items": "string",
        "default": [
          "white",
          "black",
          "black",
          "black"
        ],
        "doc": "label ink per position, chosen to contrast with that position's bar"
      },
      "width": {
        "type": "number",
        "default": 300
      },
      "height": {
        "type": "number",
        "default": 240
      },
      "title": {
        "type": "string",
        "default": ""
      },
      "description": {
        "type": "string",
        "default": "A basic grouped bar chart example.",
        "doc": "the takeaway; alt text and table-view fallback"
      }
    },
    "example": "../examples/vega/grouped-bar-chart.data.json",
    "vega": {
      "example": "grouped-bar-chart",
      "spec": "test/vega-examples/specs/grouped-bar-chart.vg.json",
      "status": "pass",
      "note": "Bars nest by yOffset; Vega picks label ink with contrast(), which Vega-Lite lacks, so labelColors gives it per position. Against the vg2png (node-canvas) reference, re-measured in eas-7r1.12 with rsvg-convert and Arimo: ratio 0.0172 (was 0.0172 against vg2svg).",
      "ratio": 0.0172,
      "threshold": 0.05,
      "measured": "eas-vega-std-basic oracle, rasterized by rsvg-convert 2.60 (librsvg) with Arimo for Arial/Helvetica (eas-7r1.12)"
    }
  },
  "title": {
    "x-eas:slot": "title"
  },
  "description": {
    "x-eas:slot": "description"
  },
  "width": {
    "x-eas:slot": "width"
  },
  "height": {
    "x-eas:slot": "height"
  },
  "data": {
    "name": "data"
  },
  "config": {
    "background": "transparent",
    "view": {
      "stroke": null
    },
    "font": "sans-serif",
    "axis": {
      "grid": false,
      "title": null,
      "labelAngle": 0,
      "domainColor": "#888",
      "tickColor": "#888",
      "gridColor": "#ddd",
      "labelColor": "#000",
      "labelFontSize": 10,
      "labelPadding": 2,
      "tickSize": 5,
      "titleColor": "#000",
      "titleFontSize": 11,
      "titleFontWeight": "bold",
      "titlePadding": 4
    },
    "legend": {
      "labelColor": "#000",
      "labelFontSize": 10,
      "titleColor": "#000",
      "titleFontSize": 11,
      "titleFontWeight": "bold",
      "symbolSize": 100
    },
    "bar": {
      "cornerRadiusEnd": 0
    },
    "rect": {
      "strokeWidth": 0
    },
    "arc": {
      "strokeWidth": 0
    },
    "area": {
      "opacity": 1
    },
    "line": {
      "strokeWidth": 1,
      "strokeCap": "butt",
      "strokeJoin": "miter"
    },
    "mark": {
      "color": "#4c78a8"
    },
    "point": {
      "filled": true
    },
    "title": {
      "anchor": "middle",
      "fontSize": 13,
      "fontWeight": "bold",
      "color": "#000"
    },
    "range": {
      "category": [
        "#4c78a8",
        "#f58518",
        "#e45756",
        "#72b7b2",
        "#54a24b",
        "#eeca3b",
        "#b279a2",
        "#ff9da6",
        "#9d755d",
        "#bab0ac"
      ]
    }
  },
  "encoding": {
    "y": {
      "field": {
        "x-eas:slot": "category"
      },
      "type": "nominal",
      "sort": null,
      "scale": {
        "paddingInner": 0.2,
        "paddingOuter": 0.2
      },
      "axis": {
        "tickSize": 0,
        "labelPadding": 4,
        "zindex": 1
      }
    },
    "yOffset": {
      "field": {
        "x-eas:slot": "position"
      },
      "type": "nominal",
      "sort": null,
      "scale": {
        "paddingInner": 0,
        "paddingOuter": 0
      }
    },
    "x": {
      "field": {
        "x-eas:slot": "value"
      },
      "type": "quantitative",
      "axis": {
        "tickCount": 10
      }
    }
  },
  "layer": [
    {
      "mark": {
        "type": "bar"
      },
      "encoding": {
        "color": {
          "field": {
            "x-eas:slot": "position"
          },
          "type": "nominal",
          "legend": null,
          "scale": {
            "scheme": {
              "x-eas:slot": "scheme"
            }
          }
        },
        "tooltip": [
          {
            "field": {
              "x-eas:slot": "category"
            },
            "type": "nominal"
          },
          {
            "field": {
              "x-eas:slot": "position"
            },
            "type": "nominal"
          },
          {
            "field": {
              "x-eas:slot": "value"
            },
            "type": "quantitative"
          }
        ]
      }
    },
    {
      "mark": {
        "type": "text",
        "align": "right",
        "baseline": "middle",
        "dx": -5
      },
      "encoding": {
        "text": {
          "field": {
            "x-eas:slot": "value"
          },
          "type": "quantitative"
        },
        "color": {
          "field": {
            "x-eas:slot": "position"
          },
          "type": "nominal",
          "legend": null,
          "scale": {
            "range": {
              "x-eas:slot": "labelColors"
            }
          }
        }
      }
    }
  ],
  "resolve": {
    "scale": {
      "color": "independent"
    }
  }
}
