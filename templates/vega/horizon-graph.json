{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "x-eas": {
    "template": "horizon-graph",
    "namespace": "vega",
    "version": "1.0.0",
    "doc": "Vega gallery horizon graph: an area chart cut into bands of equal height, overlaid so a short chart keeps its resolution.",
    "slots": {
      "data": {
        "shape": "json",
        "required": true,
        "doc": "rows with a numeric x and a value y"
      },
      "x": {
        "type": "field",
        "of": "data",
        "default": "x"
      },
      "y": {
        "type": "field",
        "of": "data",
        "default": "y"
      },
      "band": {
        "type": "number",
        "default": 50,
        "doc": "value range of one band; the chart is this tall in y units"
      },
      "offsets": {
        "type": "array",
        "items": "number",
        "default": [
          0,
          50
        ],
        "doc": "start of each band in y units: one overlaid layer per entry (layers x band)"
      },
      "opacity": {
        "type": "number",
        "default": 0.63,
        "doc": "per layer; Vega uses layers^(-2/3)"
      },
      "color": {
        "type": "string",
        "default": "steelblue"
      },
      "width": {
        "type": "number",
        "default": 500
      },
      "height": {
        "type": "number",
        "default": 100
      },
      "title": {
        "type": "string",
        "default": ""
      },
      "description": {
        "type": "string",
        "default": "A horizon graph, which preserves resolution by layering slices of an area chart.",
        "doc": "the takeaway; alt text and table-view fallback"
      }
    },
    "example": "../examples/vega/horizon-graph.data.json",
    "vega": {
      "example": "horizon-graph",
      "spec": "test/vega-examples/specs/horizon-graph.vg.json",
      "status": "pass",
      "note": "One clipped area layer per band offset; Vega's click-to-cycle layer count is the offsets slot (one entry per layer). Against the vg2png (node-canvas) reference, re-measured in eas-7r1.12 with rsvg-convert and Arimo: ratio 0.0150 (was 0.0149 against vg2svg).",
      "ratio": 0.015,
      "threshold": 0.05,
      "measured": "eas-vega-std-basic oracle, rasterized by rsvg-convert 2.60 (librsvg) with Arimo for Arial/Helvetica (eas-7r1.12)"
    }
  },
  "title": {
    "x-eas:slot": "title"
  },
  "description": {
    "x-eas:slot": "description"
  },
  "width": {
    "x-eas:slot": "width"
  },
  "height": {
    "x-eas:slot": "height"
  },
  "padding": 0,
  "data": {
    "name": "data"
  },
  "config": {
    "background": "transparent",
    "view": {
      "stroke": null
    },
    "font": "sans-serif",
    "axis": {
      "grid": false,
      "title": null,
      "labelAngle": 0,
      "domainColor": "#888",
      "tickColor": "#888",
      "gridColor": "#ddd",
      "labelColor": "#000",
      "labelFontSize": 10,
      "labelPadding": 2,
      "tickSize": 5,
      "titleColor": "#000",
      "titleFontSize": 11,
      "titleFontWeight": "bold",
      "titlePadding": 4
    },
    "legend": {
      "labelColor": "#000",
      "labelFontSize": 10,
      "titleColor": "#000",
      "titleFontSize": 11,
      "titleFontWeight": "bold",
      "symbolSize": 100
    },
    "bar": {
      "cornerRadiusEnd": 0
    },
    "rect": {
      "strokeWidth": 0
    },
    "arc": {
      "strokeWidth": 0
    },
    "area": {
      "opacity": 1
    },
    "line": {
      "strokeWidth": 1,
      "strokeCap": "butt",
      "strokeJoin": "miter"
    },
    "mark": {
      "color": "#4c78a8"
    },
    "point": {
      "filled": true
    },
    "title": {
      "anchor": "middle",
      "fontSize": 13,
      "fontWeight": "bold",
      "color": "#000"
    },
    "range": {
      "category": [
        "#4c78a8",
        "#f58518",
        "#e45756",
        "#72b7b2",
        "#54a24b",
        "#eeca3b",
        "#b279a2",
        "#ff9da6",
        "#9d755d",
        "#bab0ac"
      ]
    }
  },
  "encoding": {
    "x": {
      "field": {
        "x-eas:slot": "x"
      },
      "type": "quantitative",
      "scale": {
        "zero": false,
        "nice": false
      },
      "axis": {
        "tickCount": 20,
        "title": null
      }
    }
  },
  "layer": [
    {
      "x-eas:each": "offsets",
      "spec": {
        "transform": [
          {
            "calculate": {
              "x-eas:expr": "datum[{{y}}] - {{@}}"
            },
            "as": "x-eas-band"
          }
        ],
        "mark": {
          "type": "area",
          "interpolate": "monotone",
          "clip": true,
          "color": {
            "x-eas:slot": "color"
          },
          "opacity": {
            "x-eas:slot": "opacity"
          }
        },
        "encoding": {
          "y": {
            "field": "x-eas-band",
            "type": "quantitative",
            "scale": {
              "domain": [
                0,
                {
                  "x-eas:slot": "band"
                }
              ]
            },
            "axis": null
          }
        }
      }
    }
  ]
}
