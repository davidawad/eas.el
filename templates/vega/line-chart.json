{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "x-eas": {
    "template": "line-chart",
    "aliases": ["vega/line-chart"],
    "version": "1.0.0",
    "doc": "Vega gallery line chart: one line per series c over a point x scale; hovering a line fades it.",
    "slots": {
      "data": {
        "shape": "json",
        "required": true,
        "doc": "rows with an x, a y and a series"
      },
      "x": {
        "type": "field",
        "of": "data",
        "default": "x"
      },
      "y": {
        "type": "field",
        "of": "data",
        "default": "y"
      },
      "series": {
        "type": "field",
        "of": "data",
        "default": "c"
      },
      "interpolate": {
        "enum": [
          "basis",
          "cardinal",
          "catmull-rom",
          "linear",
          "monotone",
          "natural",
          "step",
          "step-after",
          "step-before"
        ],
        "default": "linear"
      },
      "width": {
        "type": "number",
        "default": 500
      },
      "height": {
        "type": "number",
        "default": 200
      },
      "title": {
        "type": "string",
        "default": ""
      },
      "description": {
        "type": "string",
        "default": "A basic line chart example.",
        "doc": "the takeaway; alt text and table-view fallback"
      }
    },
    "example": "../examples/vega/line-chart.data.json",
    "vega": {
      "example": "line-chart",
      "spec": "test/vega-examples/specs/line-chart.vg.json",
      "status": "pass",
      "note": "Lines over a point scale without padding; Vega's interpolate dropdown is the interpolate slot; hovering a line fades it. Against the vg2png (node-canvas) reference, re-measured in eas-7r1.12 with rsvg-convert and Arimo: ratio 0.0067 (was 0.0054 against vg2svg).",
      "ratio": 0.0067,
      "threshold": 0.05,
      "measured": "eas-vega-std-basic oracle, rasterized by rsvg-convert 2.60 (librsvg) with Arimo for Arial/Helvetica (eas-7r1.12)"
    }
  },
  "title": {
    "x-eas:slot": "title"
  },
  "description": {
    "x-eas:slot": "description"
  },
  "width": {
    "x-eas:slot": "width"
  },
  "height": {
    "x-eas:slot": "height"
  },
  "data": {
    "name": "data"
  },
  "config": {
    "background": "transparent",
    "view": {
      "stroke": null
    },
    "font": "sans-serif",
    "axis": {
      "grid": false,
      "title": null,
      "labelAngle": 0,
      "domainColor": "#888",
      "tickColor": "#888",
      "gridColor": "#ddd",
      "labelColor": "#000",
      "labelFontSize": 10,
      "labelPadding": 2,
      "tickSize": 5,
      "titleColor": "#000",
      "titleFontSize": 11,
      "titleFontWeight": "bold",
      "titlePadding": 4
    },
    "legend": {
      "labelColor": "#000",
      "labelFontSize": 10,
      "titleColor": "#000",
      "titleFontSize": 11,
      "titleFontWeight": "bold",
      "symbolSize": 100
    },
    "bar": {
      "cornerRadiusEnd": 0
    },
    "rect": {
      "strokeWidth": 0
    },
    "arc": {
      "strokeWidth": 0
    },
    "area": {
      "opacity": 1
    },
    "line": {
      "strokeWidth": 1,
      "strokeCap": "butt",
      "strokeJoin": "miter"
    },
    "mark": {
      "color": "#4c78a8"
    },
    "point": {
      "filled": true
    },
    "title": {
      "anchor": "middle",
      "fontSize": 13,
      "fontWeight": "bold",
      "color": "#000"
    },
    "range": {
      "category": [
        "#4c78a8",
        "#f58518",
        "#e45756",
        "#72b7b2",
        "#54a24b",
        "#eeca3b",
        "#b279a2",
        "#ff9da6",
        "#9d755d",
        "#bab0ac"
      ]
    }
  },
  "params": [
    {
      "name": "hover",
      "select": {
        "type": "point",
        "on": "pointerover",
        "clear": "pointerout",
        "fields": [
          {
            "x-eas:slot": "series"
          }
        ]
      }
    }
  ],
  "mark": {
    "type": "line",
    "strokeWidth": 2,
    "interpolate": {
      "x-eas:slot": "interpolate"
    }
  },
  "encoding": {
    "x": {
      "field": {
        "x-eas:slot": "x"
      },
      "type": "ordinal",
      "sort": null,
      "scale": {
        "type": "point",
        "padding": 0,
        "paddingOuter": 0
      }
    },
    "y": {
      "field": {
        "x-eas:slot": "y"
      },
      "type": "quantitative",
      "axis": {
        "tickCount": 10
      }
    },
    "color": {
      "field": {
        "x-eas:slot": "series"
      },
      "type": "nominal",
      "legend": null
    },
    "opacity": {
      "condition": {
        "param": "hover",
        "empty": false,
        "value": 0.5
      },
      "value": 1
    }
  }
}
