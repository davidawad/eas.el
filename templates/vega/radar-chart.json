{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "x-eas": {
    "template": "radar-chart",
    "aliases": ["vega/radar-chart"],
    "version": "1.0.0",
    "doc": "Vega gallery radar chart: one closed, lightly filled polygon per category over radial key axes, each vertex labelled with its value.",
    "slots": {
      "data": {
        "shape": "json",
        "required": true,
        "doc": "rows with a key (one spoke each), a value and a category (one polygon each)"
      },
      "key": {
        "type": "field",
        "of": "data",
        "default": "key"
      },
      "value": {
        "type": "field",
        "of": "data",
        "default": "value"
      },
      "category": {
        "type": "field",
        "of": "data",
        "default": "category"
      },
      "size": {
        "type": "number",
        "default": 320,
        "doc": "diameter of the outer ring in pixels"
      },
      "scheme": {
        "type": "string",
        "default": "category10"
      },
      "gridColor": {
        "type": "string",
        "default": "lightgray"
      },
      "title": {
        "type": "string",
        "default": ""
      },
      "description": {
        "type": "string",
        "default": "A radar chart example, showing multiple dimensions in a radial layout.",
        "doc": "the takeaway; alt text and table-view fallback"
      }
    },
    "example": "../examples/vega/radar-chart.data.json",
    "vega": {
      "example": "radar-chart",
      "spec": "test/vega-examples/specs/radar-chart.vg.json",
      "status": "pass",
      "note": "Polar positions computed by calculate on linear x and y; polygons are filled closed lines; the canvas keeps padding for the key labels (autosize none is not reproduced). Against the vg2png (node-canvas) reference, re-measured in eas-7r1.12 with rsvg-convert and Arimo: ratio 0.0057 (was 0.0093 against vg2svg).",
      "ratio": 0.0057,
      "threshold": 0.05,
      "measured": "eas-vega-std-basic oracle, rasterized by rsvg-convert 2.60 (librsvg) with Arimo for Arial/Helvetica (eas-7r1.12)"
    }
  },
  "title": {
    "x-eas:slot": "title"
  },
  "description": {
    "x-eas:slot": "description"
  },
  "width": {
    "x-eas:slot": "size"
  },
  "height": {
    "x-eas:slot": "size"
  },
  "padding": 40,
  "autosize": {
    "type": "none"
  },
  "data": {
    "name": "data"
  },
  "config": {
    "background": "transparent",
    "view": {
      "stroke": null
    },
    "font": "sans-serif",
    "axis": {
      "grid": false,
      "title": null,
      "labelAngle": 0,
      "domainColor": "#888",
      "tickColor": "#888",
      "gridColor": "#ddd",
      "labelColor": "#000",
      "labelFontSize": 10,
      "labelPadding": 2,
      "tickSize": 5,
      "titleColor": "#000",
      "titleFontSize": 11,
      "titleFontWeight": "bold",
      "titlePadding": 4
    },
    "legend": {
      "labelColor": "#000",
      "labelFontSize": 10,
      "titleColor": "#000",
      "titleFontSize": 11,
      "titleFontWeight": "bold",
      "symbolSize": 100
    },
    "bar": {
      "cornerRadiusEnd": 0
    },
    "rect": {
      "strokeWidth": 0
    },
    "arc": {
      "strokeWidth": 0
    },
    "area": {
      "opacity": 1
    },
    "line": {
      "strokeWidth": 1,
      "strokeCap": "butt",
      "strokeJoin": "miter"
    },
    "mark": {
      "color": "#4c78a8"
    },
    "point": {
      "filled": true
    },
    "title": {
      "anchor": "middle",
      "fontSize": 13,
      "fontWeight": "bold",
      "color": "#000"
    },
    "range": {
      "category": [
        "#4c78a8",
        "#f58518",
        "#e45756",
        "#72b7b2",
        "#54a24b",
        "#eeca3b",
        "#b279a2",
        "#ff9da6",
        "#9d755d",
        "#bab0ac"
      ]
    }
  },
  "transform": [
    {
      "window": [
        {
          "op": "row_number",
          "as": "x-eas-row"
        }
      ]
    },
    {
      "joinaggregate": [
        {
          "op": "min",
          "field": "x-eas-row",
          "as": "x-eas-first"
        }
      ],
      "groupby": [
        {
          "x-eas:slot": "key"
        }
      ]
    },
    {
      "window": [
        {
          "op": "dense_rank",
          "as": "x-eas-k"
        }
      ],
      "sort": [
        {
          "field": "x-eas-first"
        }
      ]
    },
    {
      "joinaggregate": [
        {
          "op": "max",
          "field": "x-eas-k",
          "as": "x-eas-n"
        },
        {
          "op": "max",
          "field": {
            "x-eas:slot": "value"
          },
          "as": "x-eas-max"
        }
      ]
    },
    {
      "calculate": "-PI + (datum['x-eas-k'] - 0.5) * 2 * PI / datum['x-eas-n']",
      "as": "x-eas-angle"
    },
    {
      "calculate": {
        "x-eas:expr": "{{size}} / 2 * datum[{{value}}] / datum['x-eas-max']"
      },
      "as": "x-eas-r"
    },
    {
      "calculate": {
        "x-eas:expr": "{{size}} / 2 + datum['x-eas-r'] * cos(datum['x-eas-angle'])"
      },
      "as": "x-eas-px"
    },
    {
      "calculate": {
        "x-eas:expr": "{{size}} / 2 + datum['x-eas-r'] * sin(datum['x-eas-angle'])"
      },
      "as": "x-eas-py"
    },
    {
      "calculate": {
        "x-eas:expr": "{{size}} / 2 + ({{size}} / 2 + 5) * cos(datum['x-eas-angle'])"
      },
      "as": "x-eas-lx"
    },
    {
      "calculate": {
        "x-eas:expr": "{{size}} / 2 + ({{size}} / 2 + 5) * sin(datum['x-eas-angle'])"
      },
      "as": "x-eas-ly"
    }
  ],
  "encoding": {
    "x": {
      "field": "x-eas-px",
      "type": "quantitative",
      "axis": null,
      "scale": {
        "domain": [
          0,
          {
            "x-eas:slot": "size"
          }
        ],
        "nice": false,
        "zero": false
      }
    },
    "y": {
      "field": "x-eas-py",
      "type": "quantitative",
      "axis": null,
      "scale": {
        "domain": [
          0,
          {
            "x-eas:slot": "size"
          }
        ],
        "nice": false,
        "zero": false,
        "reverse": true
      }
    }
  },
  "layer": [
    {
      "transform": [
        {
          "aggregate": [
            {
              "op": "min",
              "field": "x-eas-angle",
              "as": "x-eas-angle"
            }
          ],
          "groupby": [
            {
              "x-eas:slot": "key"
            }
          ]
        },
        {
          "calculate": {
            "x-eas:expr": "{{size}} / 2 * (1 + cos(datum['x-eas-angle']))"
          },
          "as": "x-eas-gx"
        },
        {
          "calculate": {
            "x-eas:expr": "{{size}} / 2 * (1 + sin(datum['x-eas-angle']))"
          },
          "as": "x-eas-gy"
        },
        {
          "calculate": {
            "x-eas:expr": "{{size}} / 2"
          },
          "as": "x-eas-zero"
        }
      ],
      "mark": {
        "type": "rule",
        "color": {
          "x-eas:slot": "gridColor"
        },
        "strokeWidth": 1
      },
      "encoding": {
        "x": {
          "field": "x-eas-zero"
        },
        "y": {
          "field": "x-eas-zero"
        },
        "x2": {
          "field": "x-eas-gx"
        },
        "y2": {
          "field": "x-eas-gy"
        }
      }
    },
    {
      "transform": [
        {
          "aggregate": [
            {
              "op": "min",
              "field": "x-eas-angle",
              "as": "x-eas-angle"
            }
          ],
          "groupby": [
            {
              "x-eas:slot": "key"
            }
          ]
        },
        {
          "calculate": {
            "x-eas:expr": "{{size}} / 2 * (1 + cos(datum['x-eas-angle']))"
          },
          "as": "x-eas-gx"
        },
        {
          "calculate": {
            "x-eas:expr": "{{size}} / 2 * (1 + sin(datum['x-eas-angle']))"
          },
          "as": "x-eas-gy"
        },
        {
          "calculate": {
            "x-eas:expr": "{{size}} / 2"
          },
          "as": "x-eas-zero"
        }
      ],
      "mark": {
        "type": "line",
        "interpolate": "linear-closed",
        "color": {
          "x-eas:slot": "gridColor"
        },
        "strokeWidth": 1
      },
      "encoding": {
        "x": {
          "field": "x-eas-gx"
        },
        "y": {
          "field": "x-eas-gy"
        },
        "order": {
          "field": "x-eas-angle",
          "type": "quantitative"
        }
      }
    },
    {
      "mark": {
        "type": "line",
        "interpolate": "linear-closed",
        "strokeWidth": 1,
        "fillOpacity": 0.1
      },
      "encoding": {
        "color": {
          "field": {
            "x-eas:slot": "category"
          },
          "type": "nominal",
          "legend": null,
          "scale": {
            "scheme": {
              "x-eas:slot": "scheme"
            }
          }
        },
        "fill": {
          "field": {
            "x-eas:slot": "category"
          },
          "type": "nominal",
          "legend": null,
          "scale": {
            "scheme": {
              "x-eas:slot": "scheme"
            }
          }
        },
        "order": {
          "field": "x-eas-k",
          "type": "quantitative"
        },
        "tooltip": [
          {
            "field": {
              "x-eas:slot": "category"
            },
            "type": "nominal"
          },
          {
            "field": {
              "x-eas:slot": "key"
            },
            "type": "nominal"
          },
          {
            "field": {
              "x-eas:slot": "value"
            },
            "type": "quantitative"
          }
        ]
      }
    },
    {
      "mark": {
        "type": "text",
        "align": "center",
        "baseline": "middle",
        "color": "black"
      },
      "encoding": {
        "text": {
          "field": {
            "x-eas:slot": "value"
          },
          "type": "quantitative"
        }
      }
    },
    {
      "transform": [
        {
          "aggregate": [
            {
              "op": "min",
              "field": "x-eas-angle",
              "as": "x-eas-angle"
            }
          ],
          "groupby": [
            {
              "x-eas:slot": "key"
            }
          ]
        },
        {
          "calculate": {
            "x-eas:expr": "{{size}} / 2 * (1 + cos(datum['x-eas-angle']))"
          },
          "as": "x-eas-gx"
        },
        {
          "calculate": {
            "x-eas:expr": "{{size}} / 2 * (1 + sin(datum['x-eas-angle']))"
          },
          "as": "x-eas-gy"
        },
        {
          "calculate": {
            "x-eas:expr": "{{size}} / 2"
          },
          "as": "x-eas-zero"
        },
        {
          "calculate": {
            "x-eas:expr": "{{size}} / 2 + ({{size}} / 2 + 5) * cos(datum['x-eas-angle'])"
          },
          "as": "x-eas-lx"
        },
        {
          "calculate": {
            "x-eas:expr": "{{size}} / 2 + ({{size}} / 2 + 5) * sin(datum['x-eas-angle'])"
          },
          "as": "x-eas-ly"
        },
        {
          "calculate": "abs(datum['x-eas-angle']) > PI / 2 ? 'right' : 'left'",
          "as": "x-eas-align"
        },
        {
          "calculate": "abs(datum['x-eas-angle']) < 1e-9 ? 'middle' : datum['x-eas-angle'] > 0 ? 'top' : 'bottom'",
          "as": "x-eas-baseline"
        }
      ],
      "layer": [
        {
          "transform": [
            {
              "filter": "datum['x-eas-align'] == 'left' && datum['x-eas-baseline'] == 'top'"
            }
          ],
          "mark": {
            "type": "text",
            "align": "left",
            "baseline": "top",
            "color": "black",
            "fontWeight": "bold"
          },
          "encoding": {
            "x": {
              "field": "x-eas-lx"
            },
            "y": {
              "field": "x-eas-ly"
            },
            "text": {
              "field": {
                "x-eas:slot": "key"
              },
              "type": "nominal"
            }
          }
        },
        {
          "transform": [
            {
              "filter": "datum['x-eas-align'] == 'left' && datum['x-eas-baseline'] == 'middle'"
            }
          ],
          "mark": {
            "type": "text",
            "align": "left",
            "baseline": "middle",
            "color": "black",
            "fontWeight": "bold"
          },
          "encoding": {
            "x": {
              "field": "x-eas-lx"
            },
            "y": {
              "field": "x-eas-ly"
            },
            "text": {
              "field": {
                "x-eas:slot": "key"
              },
              "type": "nominal"
            }
          }
        },
        {
          "transform": [
            {
              "filter": "datum['x-eas-align'] == 'left' && datum['x-eas-baseline'] == 'bottom'"
            }
          ],
          "mark": {
            "type": "text",
            "align": "left",
            "baseline": "bottom",
            "color": "black",
            "fontWeight": "bold"
          },
          "encoding": {
            "x": {
              "field": "x-eas-lx"
            },
            "y": {
              "field": "x-eas-ly"
            },
            "text": {
              "field": {
                "x-eas:slot": "key"
              },
              "type": "nominal"
            }
          }
        },
        {
          "transform": [
            {
              "filter": "datum['x-eas-align'] == 'right' && datum['x-eas-baseline'] == 'top'"
            }
          ],
          "mark": {
            "type": "text",
            "align": "right",
            "baseline": "top",
            "color": "black",
            "fontWeight": "bold"
          },
          "encoding": {
            "x": {
              "field": "x-eas-lx"
            },
            "y": {
              "field": "x-eas-ly"
            },
            "text": {
              "field": {
                "x-eas:slot": "key"
              },
              "type": "nominal"
            }
          }
        },
        {
          "transform": [
            {
              "filter": "datum['x-eas-align'] == 'right' && datum['x-eas-baseline'] == 'middle'"
            }
          ],
          "mark": {
            "type": "text",
            "align": "right",
            "baseline": "middle",
            "color": "black",
            "fontWeight": "bold"
          },
          "encoding": {
            "x": {
              "field": "x-eas-lx"
            },
            "y": {
              "field": "x-eas-ly"
            },
            "text": {
              "field": {
                "x-eas:slot": "key"
              },
              "type": "nominal"
            }
          }
        },
        {
          "transform": [
            {
              "filter": "datum['x-eas-align'] == 'right' && datum['x-eas-baseline'] == 'bottom'"
            }
          ],
          "mark": {
            "type": "text",
            "align": "right",
            "baseline": "bottom",
            "color": "black",
            "fontWeight": "bold"
          },
          "encoding": {
            "x": {
              "field": "x-eas-lx"
            },
            "y": {
              "field": "x-eas-ly"
            },
            "text": {
              "field": {
                "x-eas:slot": "key"
              },
              "type": "nominal"
            }
          }
        }
      ]
    }
  ]
}
