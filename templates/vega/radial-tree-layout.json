            }
          }
        }
      ],
      "mark": {
        "type": "point",
        "shape": "circle",
        "filled": true,
        "size": 100,
        "opacity": 1,
        "stroke": "#fff",
        "strokeWidth": 1
      },
      "encoding": {
        "x": {
          "field": "x",
          "type": "quantitative"
        },
        "y": {
          "field": "y",
          "type": "quantitative"
        },
        "color": {
          "field": "depth",
          "type": "quantitative",
          "legend": null,
          "scale": {
            "scheme": {
              "x-eas:slot": "scheme"
            },
            "zero": true
          }
        },
        "tooltip": [
          {
            "field": {
              "x-eas:slot": "label"
            },
            "type": "nominal"
          },
          {
            "field": "depth",
            "type": "quantitative"
          }
