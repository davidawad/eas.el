{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "x-eas": {
    "template": "radial-tree-layout",
    "namespace": "vega",
    "version": "1.0.0",
    "doc": "A radial node-link tree of id/parent rows: tidy or cluster layout around the centre, links as lines, curves, diagonals or elbows, labels turned along their spokes.",
    "slots": {
      "data": {
        "shape": "plist",
        "required": true,
        "doc": "one row per node: a key, the parent's key (null at the root) and a label"
      },
      "key": {
        "type": "field",
        "of": "data",
        "default": "id"
      },
      "parent": {
        "type": "field",
        "of": "data",
        "default": "parent",
        "doc": "the parent's key; exactly one row has none"
      },
      "label": {
        "type": "field",
        "of": "data",
        "default": "name"
      },
      "method": {
        "enum": [
          "tidy",
          "cluster"
        ],
        "default": "tidy"
      },
      "links": {
        "enum": [
          "line",
          "curve",
          "diagonal",
          "orthogonal"
        ],
        "default": "line"
      },
      "radius": {
        "type": "number",
        "default": 280,
        "doc": "radius of the deepest ring, in pixels"
      },
      "extent": {
        "type": "number",
        "default": 360,
        "doc": "degrees of the circle the tree spans"
      },
      "rotate": {
        "type": "number",
        "default": 0,
        "doc": "degrees the tree turns clockwise"
      },
      "labels": {
        "type": "boolean",
        "default": true
      },
      "width": {
        "type": "number",
        "default": 720
      },
      "height": {
        "type": "number",
        "default": 720
      },
      "scheme": {
        "type": "string",
        "default": "magma",
        "doc": "color scheme of node depth"
      },
      "title": {
        "type": "string",
        "default": ""
      },
      "description": {
        "type": "string",
        "default": "A radial node-link tree: the root at the centre, each depth on a ring further out."
      }
    },
    "example": "../examples/vega/radial-tree-layout.data.json",
    "vega": {
      "status": "pass",
      "note": "Angles, spokes and rotated labels match Vega. Vega's bound widgets (labels, radius, extent, rotate, layout, links) are slots. Against the vg2png (node-canvas) reference, re-measured in eas-7r1.12 with rsvg-convert and Arimo: ratio 0.0466 (was 0.025 against vg2svg); geometry matches; the rest is the font-raster floor: the references' sans-serif is Helvetica (node-canvas on macOS), native SVG here is drawn in Arimo (Arial metrics), so glyph edges differ while positions match.",
      "ratio": 0.0466
    }
  },
  "title": {
    "x-eas:slot": "title"
  },
  "description": {
    "x-eas:slot": "description"
  },
  "width": {
    "x-eas:slot": "width"
  },
  "height": {
    "x-eas:slot": "height"
  },
  "padding": 5,
  "config": {
    "view": {
      "stroke": null
    }
  },
  "layer": [
    {
      "data": {
        "name": "data"
      },
      "transform": [
        {
          "x-eas:transform": "tree",
          "key": {
            "x-eas:slot": "key"
          },
          "parentKey": {
            "x-eas:slot": "parent"
          },
          "method": {
            "x-eas:slot": "method"
          },
          "size": [
            1,
            {
              "x-eas:slot": "radius"
            }
          ],
          "as": [
            "alpha",
            "radius",
            "depth",
            "children"
          ]
        },
        {
          "x-eas:transform": "formula",
          "expr": "(rotate + extent * datum.alpha + 270) % 360",
          "as": "angle",
          "params": {
            "rotate": {
              "x-eas:slot": "rotate"
            },
            "extent": {
              "x-eas:slot": "extent"
            },
            "width": {
              "x-eas:slot": "width"
            },
            "height": {
              "x-eas:slot": "height"
            }
          }
        },
        {
          "x-eas:transform": "formula",
          "expr": "PI * datum.angle / 180",
          "as": "radians",
          "params": {
            "rotate": {
              "x-eas:slot": "rotate"
            },
            "extent": {
              "x-eas:slot": "extent"
            },
            "width": {
              "x-eas:slot": "width"
            },
            "height": {
              "x-eas:slot": "height"
            }
          }
        },
        {
          "x-eas:transform": "formula",
          "expr": "inrange(datum.angle, [90, 270])",
          "as": "leftside",
          "params": {
            "rotate": {
              "x-eas:slot": "rotate"
            },
            "extent": {
              "x-eas:slot": "extent"
            },
            "width": {
              "x-eas:slot": "width"
            },
            "height": {
              "x-eas:slot": "height"
            }
          }
        },
        {
          "x-eas:transform": "formula",
          "expr": "width / 2 + datum.radius * cos(datum.radians)",
          "as": "x",
          "params": {
            "rotate": {
              "x-eas:slot": "rotate"
            },
            "extent": {
              "x-eas:slot": "extent"
            },
            "width": {
              "x-eas:slot": "width"
            },
            "height": {
              "x-eas:slot": "height"
            }
          }
        },
        {
          "x-eas:transform": "formula",
          "expr": "height / 2 + datum.radius * sin(datum.radians)",
          "as": "y",
          "params": {
            "rotate": {
              "x-eas:slot": "rotate"
            },
            "extent": {
              "x-eas:slot": "extent"
            },
            "width": {
              "x-eas:slot": "width"
            },
            "height": {
              "x-eas:slot": "height"
            }
          }
        },
        {
          "x-eas:transform": "formula",
          "expr": "datum.leftside ? datum.angle - 180 : datum.angle",
          "as": "labelAngle",
          "params": {
            "rotate": {
              "x-eas:slot": "rotate"
            },
            "extent": {
              "x-eas:slot": "extent"
            },
            "width": {
              "x-eas:slot": "width"
            },
            "height": {
              "x-eas:slot": "height"
            }
          }
        },
        {
          "x-eas:transform": "treelinks",
          "key": {
            "x-eas:slot": "key"
          },
          "parentKey": {
            "x-eas:slot": "parent"
          }
        },
        {
          "x-eas:transform": "linkpath",
          "shape": {
            "x-eas:slot": "links"
          },
          "orient": "radial",
          "sourceX": "source.radians",
          "sourceY": "source.radius",
          "targetX": "target.radians",
          "targetY": "target.radius",
          "as": [
            "px",
            "py",
            "step",
            "link"
          ]
        },
        {
          "calculate": {
            "x-eas:expr": "datum.px + {{width}} / 2"
          },
          "as": "x"
        },
        {
          "calculate": {
            "x-eas:expr": "datum.py + {{height}} / 2"
          },
          "as": "y"
        }
      ],
      "mark": {
        "type": "line",
        "stroke": "#ccc",
        "strokeWidth": 1
      },
      "encoding": {
        "x": {
          "field": "x",
          "type": "quantitative",
          "axis": null,
          "scale": {
            "domain": [
              0,
              {
                "x-eas:slot": "width"
              }
            ],
            "nice": false,
            "zero": false
          }
        },
        "y": {
          "field": "y",
          "type": "quantitative",
          "axis": null,
          "scale": {
            "domain": [
              0,
              {
                "x-eas:slot": "height"
              }
            ],
            "reverse": true,
            "nice": false,
            "zero": false
          }
        },
        "detail": {
          "field": "link",
          "type": "nominal"
        },
        "order": {
          "field": "step",
          "type": "quantitative"
        }
      }
    },
    {
