{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "x-eas": {
    "template": "regression",
    "namespace": "vega",
    "version": "1.0.0",
    "doc": "Vega gallery regression: a scatter plot with a fitted trend line (linear, log, exp, pow, quad or poly).",
    "slots": {
      "data": {
        "shape": "json",
        "required": true,
        "doc": "rows with x and y columns; rows missing either are dropped"
      },
      "x": {
        "type": "field",
        "of": "data",
        "default": "Rotten Tomatoes Rating"
      },
      "y": {
        "type": "field",
        "of": "data",
        "default": "IMDB Rating"
      },
      "lineColor": {
        "type": "string",
        "default": "firebrick"
      },
      "width": {
        "type": "number",
        "default": 500
      },
      "height": {
        "type": "number",
        "default": 500
      },
      "method": {
        "enum": [
          "linear",
          "log",
          "exp",
          "pow",
          "quad",
          "poly"
        ],
        "default": "linear"
      },
      "order": {
        "type": "integer",
        "default": 3,
        "doc": "polynomial order when method is poly"
      },
      "title": {
        "type": "string",
        "default": ""
      },
      "description": {
        "type": "string",
        "default": "A scatter plot with trend line calculated via user-configurable regression methods.",
        "doc": "the takeaway; alt text and table-view fallback"
      }
    },
    "example": "../examples/vega/regression.data.json",
    "vega": {
      "example": "regression",
      "spec": "test/vega-examples/specs/regression.vg.json",
      "status": "pass",
      "note": "Points and the trend line; Vega's method and order controls are the method and order slots (no genre grouping).",
      "ratio": 0.0047,
      "threshold": 0.05,
      "measured": "eas-vega-std-basic oracle, rasterized by resvg 2.6 with a stand-in sans font (no rsvg-convert in the authoring box)"
    }
  },
  "title": {
    "x-eas:slot": "title"
  },
  "description": {
    "x-eas:slot": "description"
  },
  "width": {
    "x-eas:slot": "width"
  },
  "height": {
    "x-eas:slot": "height"
  },
  "data": {
    "name": "data"
  },
  "config": {
    "background": "transparent",
    "view": {
      "stroke": null
    },
    "font": "sans-serif",
    "axis": {
      "grid": false,
      "title": null,
      "labelAngle": 0,
      "domainColor": "#888",
      "tickColor": "#888",
      "gridColor": "#ddd",
      "labelColor": "#000",
      "labelFontSize": 10,
      "labelPadding": 2,
      "tickSize": 5,
      "titleColor": "#000",
      "titleFontSize": 11,
      "titleFontWeight": "bold",
      "titlePadding": 4,
      "domain": false,
      "ticks": false,
      "labels": false
    },
    "legend": {
      "labelColor": "#000",
      "labelFontSize": 10,
      "titleColor": "#000",
      "titleFontSize": 11,
      "titleFontWeight": "bold",
      "symbolSize": 100
    },
    "bar": {
      "cornerRadiusEnd": 0
    },
    "rect": {
      "strokeWidth": 0
    },
    "arc": {
      "strokeWidth": 0
    },
    "area": {
      "opacity": 1
    },
    "line": {
      "strokeWidth": 1,
      "strokeCap": "butt",
      "strokeJoin": "miter"
    },
    "mark": {
      "color": "#4c78a8"
    },
    "point": {
      "filled": true
    },
    "title": {
      "anchor": "middle",
      "fontSize": 13,
      "fontWeight": "bold",
      "color": "#000"
    },
    "range": {
      "category": [
        "#4c78a8",
        "#f58518",
        "#e45756",
        "#72b7b2",
        "#54a24b",
        "#eeca3b",
        "#b279a2",
        "#ff9da6",
        "#9d755d",
        "#bab0ac"
      ]
    }
  },
  "transform": [
    {
      "filter": {
        "field": {
          "x-eas:slot": "x"
        },
        "valid": true
      }
    },
    {
      "filter": {
        "field": {
          "x-eas:slot": "y"
        },
        "valid": true
      }
    }
  ],
  "layer": [
    {
      "mark": {
        "type": "point",
        "filled": true,
        "size": 16,
        "opacity": 1,
        "fillOpacity": 0.5,
        "strokeWidth": 0
      },
      "encoding": {
        "x": {
          "field": {
            "x-eas:slot": "x"
          },
          "type": "quantitative",
          "scale": {
            "nice": false,
            "zero": true
          },
          "axis": null
        },
        "y": {
          "field": {
            "x-eas:slot": "y"
          },
          "type": "quantitative",
          "scale": {
            "nice": false,
            "zero": true
          },
          "axis": null
        }
      }
    },
    {
      "transform": [
        {
          "on": {
            "x-eas:slot": "x"
          },
          "as": [
            "u",
            "v"
          ],
          "regression": {
            "x-eas:slot": "y"
          },
          "method": {
            "x-eas:slot": "method"
          },
          "order": {
            "x-eas:slot": "order"
          }
        }
      ],
      "mark": {
        "type": "line",
        "color": {
          "x-eas:slot": "lineColor"
        }
      },
      "encoding": {
        "x": {
          "field": "u",
          "type": "quantitative"
        },
        "y": {
          "field": "v",
          "type": "quantitative"
        }
      }
    }
  ]
}
