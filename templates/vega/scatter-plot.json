{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "x-eas": {
    "template": "scatter-plot",
    "aliases": ["vega/scatter-plot"],
    "version": "1.0.0",
    "doc": "Vega gallery scatter plot: hollow circles of y against x, sized by a third field, with a size legend.",
    "slots": {
      "data": {
        "shape": "json",
        "required": true,
        "doc": "rows with x, y and size columns; rows missing any are dropped"
      },
      "x": {
        "type": "field",
        "of": "data",
        "default": "Horsepower"
      },
      "y": {
        "type": "field",
        "of": "data",
        "default": "Miles_per_Gallon"
      },
      "size": {
        "type": "field",
        "of": "data",
        "default": "Acceleration"
      },
      "color": {
        "type": "string",
        "default": "#4682b4"
      },
      "width": {
        "type": "number",
        "default": 200
      },
      "height": {
        "type": "number",
        "default": 200
      },
      "title": {
        "type": "string",
        "default": ""
      },
      "description": {
        "type": "string",
        "default": "A basic scatter plot example depicting automobile statistics.",
        "doc": "the takeaway; alt text and table-view fallback"
      }
    },
    "example": "../examples/vega/scatter-plot.data.json",
    "vega": {
      "example": "scatter-plot",
      "spec": "test/vega-examples/specs/scatter-plot.vg.json",
      "status": "pass",
      "note": "Hollow circles sized by a third field with a size legend. Against the vg2png (node-canvas) reference, re-measured in eas-7r1.12 with rsvg-convert and Arimo: ratio 0.0340 (was 0.0384 against vg2svg).",
      "ratio": 0.034,
      "threshold": 0.06,
      "measured": "eas-vega-std-basic oracle, rasterized by rsvg-convert 2.60 (librsvg) with Arimo for Arial/Helvetica (eas-7r1.12)"
    }
  },
  "title": {
    "x-eas:slot": "title"
  },
  "description": {
    "x-eas:slot": "description"
  },
  "width": {
    "x-eas:slot": "width"
  },
  "height": {
    "x-eas:slot": "height"
  },
  "data": {
    "name": "data"
  },
  "config": {
    "background": "transparent",
    "view": {
      "stroke": null
    },
    "font": "sans-serif",
    "axis": {
      "grid": false,
      "title": null,
      "labelAngle": 0,
      "domainColor": "#888",
      "tickColor": "#888",
      "gridColor": "#ddd",
      "labelColor": "#000",
      "labelFontSize": 10,
      "labelPadding": 2,
      "tickSize": 5,
      "titleColor": "#000",
      "titleFontSize": 11,
      "titleFontWeight": "bold",
      "titlePadding": 4
    },
    "legend": {
      "labelColor": "#000",
      "labelFontSize": 10,
      "titleColor": "#000",
      "titleFontSize": 11,
      "titleFontWeight": "bold",
      "symbolSize": 100
    },
    "bar": {
      "cornerRadiusEnd": 0
    },
    "rect": {
      "strokeWidth": 0
    },
    "arc": {
      "strokeWidth": 0
    },
    "area": {
      "opacity": 1
    },
    "line": {
      "strokeWidth": 1,
      "strokeCap": "butt",
      "strokeJoin": "miter"
    },
    "mark": {
      "color": "#4c78a8"
    },
    "point": {
      "filled": true
    },
    "title": {
      "anchor": "middle",
      "fontSize": 13,
      "fontWeight": "bold",
      "color": "#000"
    },
    "range": {
      "category": [
        "#4c78a8",
        "#f58518",
        "#e45756",
        "#72b7b2",
        "#54a24b",
        "#eeca3b",
        "#b279a2",
        "#ff9da6",
        "#9d755d",
        "#bab0ac"
      ]
    }
  },
  "transform": [
    {
      "filter": {
        "field": {
          "x-eas:slot": "x"
        },
        "valid": true
      }
    },
    {
      "filter": {
        "field": {
          "x-eas:slot": "y"
        },
        "valid": true
      }
    },
    {
      "filter": {
        "field": {
          "x-eas:slot": "size"
        },
        "valid": true
      }
    }
  ],
  "mark": {
    "type": "point",
    "shape": "circle",
    "filled": false,
    "strokeWidth": 2,
    "opacity": 0.5,
    "color": {
      "x-eas:slot": "color"
    }
  },
  "encoding": {
    "x": {
      "field": {
        "x-eas:slot": "x"
      },
      "type": "quantitative",
      "axis": {
        "grid": true,
        "domain": false,
        "tickCount": 5,
        "title": {
          "x-eas:slot": "x"
        }
      }
    },
    "y": {
      "field": {
        "x-eas:slot": "y"
      },
      "type": "quantitative",
      "axis": {
        "grid": true,
        "domain": false,
        "titlePadding": 5,
        "title": {
          "x-eas:slot": "y"
        },
        "tickCount": 10
      }
    },
    "size": {
      "field": {
        "x-eas:slot": "size"
      },
      "type": "quantitative",
      "scale": {
        "range": [
          4,
          361
        ],
        "zero": true,
        "nice": false
      },
      "legend": {
        "title": {
          "x-eas:slot": "size"
        },
        "symbolStrokeColor": {
          "x-eas:slot": "color"
        },
        "symbolStrokeWidth": 2,
        "symbolOpacity": 0.5,
        "symbolType": "circle",
        "symbolFillColor": "transparent"
      }
    },
    "tooltip": [
      {
        "field": {
          "x-eas:slot": "x"
        },
        "type": "quantitative"
      },
      {
        "field": {
          "x-eas:slot": "y"
        },
        "type": "quantitative"
      },
      {
        "field": {
          "x-eas:slot": "size"
        },
        "type": "quantitative"
      }
    ]
  }
}
