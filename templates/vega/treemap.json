        }
      }
    },
    {
      "data": {
        "name": "data"
      },
      "transform": [
        {
          "x-eas:transform": "treemap",
          "key": {
            "x-eas:slot": "key"
          },
          "parentKey": {
            "x-eas:slot": "parent"
          },
          "field": {
            "x-eas:slot": "size"
          },
          "sort": {
            "field": "value"
          },
          "round": {
            "x-eas:slot": "round"
          },
          "method": {
            "x-eas:slot": "method"
          },
          "ratio": {
            "x-eas:slot": "ratio"
          },
          "size": [
            {
