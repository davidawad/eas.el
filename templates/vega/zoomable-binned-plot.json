{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "x-eas": {
    "template": "zoomable-binned-plot",
    "version": "1.0.0",
    "doc": "Points over a 2D binned density heatmap; drag pans and the wheel zooms both layers (Vega gallery: zoomable-binned-plot).",
    "slots": {
      "data": {
        "shape": "plist",
        "required": true,
        "doc": "rows with two quantitative columns"
      },
      "x": {
        "type": "field",
        "of": "data",
        "default": "u"
      },
      "y": {
        "type": "field",
        "of": "data",
        "default": "v"
      },
      "maxbins": {
        "type": "number",
        "default": 12,
        "doc": "most bins per axis"
      },
      "scheme": {
        "type": "string",
        "default": "yellowgreenblue",
        "doc": "colour scheme of the counts"
      },
      "width": {
        "type": "number",
        "default": 500
      },
      "height": {
        "type": "number",
        "default": 300
      },
      "size": {
        "type": "number",
        "default": 18,
        "doc": "point area in square pixels"
      },
      "description": {
        "type": "string",
        "default": "An interactive scatter plot example with binned aggregation supporting pan and zoom."
      },
      "title": {
        "type": "string",
        "default": "",
        "doc": "chart title (the gallery example has none)"
      }
    },
    "example": "../examples/vega/zoomable-binned-plot.data.json",
    "vega": {
      "status": "partial",
      "note": "The density heatmap and the points pan and zoom together (a param bound to scales), but the bins stay those of the full extent: Vega re-bins the visible domain while zooming. Vega-Lite can say it (bin extent {param}), but eas does not yet feed a scales-bound selection's zoomed domains to a bin extent (they live in the view state's domains, not in the params) nor pick the extent's field. The axes sit where Vega's do (orient top and right with ExprRef offsets onto the padding's outer edges) and the cells are unstroked. Against the vg2png (node-canvas) reference, re-measured in eas-7r1.12d with rsvg-convert and Liberation Sans: ratio 0.0083 (was 0.0318: 0.0197 from the theme's white rect stroke, 0.0038 from the axis placement); the rest is Monaco falling back to a different monospace and dot antialiasing.",
      "ratio": 0.0083,
      "threshold": 0.015
    }
  },
  "title": {
    "x-eas:slot": "title"
  },
  "description": {
    "x-eas:slot": "description"
  },
  "data": {
    "name": "data"
  },
  "width": {
    "x-eas:slot": "width"
  },
  "height": {
    "x-eas:slot": "height"
  },
  "padding": 0,
  "config": {
    "background": "transparent",
    "font": "sans-serif",
    "view": {
      "stroke": null
    },
    "axis": {
      "domain": false,
      "tickSize": 3,
      "tickColor": "#888",
      "labelColor": "#000",
      "labelFontSize": 10,
      "labelPadding": 2,
      "labelFont": "Monaco, Courier New, monospace",
      "grid": false,
      "title": null
    },
    "rect": {
      "stroke": null
    }
  },
  "encoding": {
    "x": {
      "field": {
        "x-eas:slot": "x"
      },
      "type": "quantitative",
      "scale": {
        "zero": false,
        "nice": false
      },
      "axis": {
        "orient": "top",
        "tickCount": 10,
        "offset": {
          "expr": {
            "x-eas:expr": "-({{height}} + 20)"
          }
        }
      }
    },
    "y": {
      "field": {
        "x-eas:slot": "y"
      },
      "type": "quantitative",
      "scale": {
        "zero": false,
        "nice": false
      },
      "axis": {
        "orient": "right",
        "tickCount": 10,
        "offset": {
          "expr": {
            "x-eas:expr": "-({{width}} + 40)"
          }
        }
      }
    }
  },
  "layer": [
    {
      "transform": [
        {
          "bin": {
            "maxbins": {
              "x-eas:slot": "maxbins"
            }
          },
          "field": {
            "x-eas:slot": "x"
          },
          "as": [
            "bx0",
            "bx1"
          ]
        },
        {
          "bin": {
            "maxbins": {
              "x-eas:slot": "maxbins"
            }
          },
          "field": {
            "x-eas:slot": "y"
          },
          "as": [
            "by0",
            "by1"
          ]
        },
        {
          "joinaggregate": [
            {
              "op": "min",
              "field": {
                "x-eas:slot": "x"
              },
              "as": "xmin"
            },
            {
              "op": "max",
              "field": {
                "x-eas:slot": "x"
              },
              "as": "xmax"
            },
            {
              "op": "min",
              "field": {
                "x-eas:slot": "y"
              },
              "as": "ymin"
            },
            {
              "op": "max",
              "field": {
                "x-eas:slot": "y"
              },
              "as": "ymax"
            }
          ]
        },
        {
          "aggregate": [
            {
              "op": "count",
              "as": "count"
            }
          ],
          "groupby": [
            "bx0",
            "bx1",
            "by0",
            "by1",
            "xmin",
            "xmax",
            "ymin",
            "ymax"
          ]
        },
        {
          "calculate": "max(datum.bx0, datum.xmin)",
          "as": "x0"
        },
        {
          "calculate": "min(datum.bx1, datum.xmax)",
          "as": "x1"
        },
        {
          "calculate": "max(datum.by0, datum.ymin)",
          "as": "y0"
        },
        {
          "calculate": "min(datum.by1, datum.ymax)",
          "as": "y1"
        }
      ],
      "mark": {
        "type": "rect",
        "clip": true
      },
      "encoding": {
        "x": {
          "field": "x0",
          "type": "quantitative"
        },
        "x2": {
          "field": "x1"
        },
        "y": {
          "field": "y0",
          "type": "quantitative"
        },
        "y2": {
          "field": "y1"
        },
        "color": {
          "field": "count",
          "type": "quantitative",
          "legend": null,
          "scale": {
            "scheme": {
              "x-eas:slot": "scheme"
            },
            "zero": false
          }
        }
      }
    },
    {
      "params": [
        {
          "name": "grid",
          "select": "interval",
          "bind": "scales"
        }
      ],
      "mark": {
        "type": "point",
        "filled": true,
        "color": "black",
        "opacity": 0.6,
        "size": {
          "x-eas:slot": "size"
        },
        "clip": true
      }
    }
  ]
}
