{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "x-eas": {
    "template": "zoomable-scatter-plot",
    "aliases": ["vega/zoomable-scatter-plot"],
    "version": "1.0.0",
    "doc": "A scatter plot that pans (drag) and zooms (wheel, + and -) and highlights the point under the pointer (Vega gallery: zoomable-scatter-plot).",
    "slots": {
      "data": {
        "shape": "plist",
        "required": true,
        "doc": "rows with two quantitative columns"
      },
      "x": {
        "type": "field",
        "of": "data",
        "default": "u"
      },
      "y": {
        "type": "field",
        "of": "data",
        "default": "v"
      },
      "width": {
        "type": "number",
        "default": 500
      },
      "height": {
        "type": "number",
        "default": 300
      },
      "size": {
        "type": "number",
        "default": 18,
        "doc": "point area in square pixels"
      },
      "color": {
        "type": "string",
        "default": "steelblue"
      },
      "hover_color": {
        "type": "string",
        "default": "firebrick"
      },
      "description": {
        "type": "string",
        "default": "An interactive scatter plot example supporting pan and zoom."
      },
      "title": {
        "type": "string",
        "default": "",
        "doc": "chart title (the gallery example has none)"
      }
    },
    "example": "../examples/vega/zoomable-scatter-plot.data.json",
    "vega": {
      "status": "pass",
      "note": "Drag pans and the wheel (or + and -) zooms through a param bound to scales; the point under the pointer turns firebrick. Vega grows the points as it zooms in; here they keep their size. Against the vg2png (node-canvas) reference, re-measured in eas-7r1.12 with rsvg-convert and Arimo: ratio 0.0121 (was 0.0121 against vg2svg).",
      "ratio": 0.0121,
      "threshold": 0.03
    }
  },
  "title": {
    "x-eas:slot": "title"
  },
  "description": {
    "x-eas:slot": "description"
  },
  "data": {
    "name": "data"
  },
  "width": {
    "x-eas:slot": "width"
  },
  "height": {
    "x-eas:slot": "height"
  },
  "padding": 5,
  "config": {
    "background": "transparent",
    "font": "sans-serif",
    "view": {
      "stroke": null
    },
    "axis": {
      "domain": false,
      "tickSize": 3,
      "tickColor": "#888",
      "labelColor": "#000",
      "labelFontSize": 10,
      "labelPadding": 2,
      "labelFont": "Monaco, Courier New, monospace",
      "grid": false,
      "title": null
    }
  },
  "params": [
    {
      "name": "grid",
      "select": "interval",
      "bind": "scales"
    },
    {
      "name": "hover",
      "select": {
        "type": "point",
        "on": "pointerover",
        "clear": "pointerout"
      }
    }
  ],
  "mark": {
    "type": "point",
    "filled": true,
    "opacity": 0.6,
    "size": {
      "x-eas:slot": "size"
    },
    "clip": true
  },
  "encoding": {
    "x": {
      "field": {
        "x-eas:slot": "x"
      },
      "type": "quantitative",
      "scale": {
        "zero": false,
        "nice": false
      },
      "axis": {
        "orient": "bottom",
        "tickCount": 10
      }
    },
    "y": {
      "field": {
        "x-eas:slot": "y"
      },
      "type": "quantitative",
      "scale": {
        "zero": false,
        "nice": false
      },
      "axis": {
        "orient": "left",
        "tickCount": 10
      }
    },
    "color": {
      "condition": {
        "param": "hover",
        "empty": false,
        "value": {
          "x-eas:slot": "hover_color"
        }
      },
      "value": {
        "x-eas:slot": "color"
      }
    }
  }
}
