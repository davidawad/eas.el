{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "data": {
    "values": [
      {
        "category": "A",
        "value": 28
      },
      {
        "category": "B",
        "value": 55
      },
      {
        "category": "C",
        "value": 43
      },
      {
        "category": "D",
        "value": 91
      },
      {
        "category": "E",
        "value": 81
      }
    ]
  },
  "description": "Filter by expression, then calculate a column.",
  "encoding": {
    "x": {
      "field": "category",
      "type": "nominal"
    },
    "y": {
      "field": "double",
      "type": "quantitative"
    }
  },
  "mark": "bar",
  "transform": [
    {
      "filter": "datum.value > 30"
    },
    {
      "as": "double",
      "calculate": "datum.value * 2"
    }
  ],
  "usermeta": {
    "easel": {
      "standin_ratio": 0.0245,
      "threshold": 0.05
    }
  }
}
