{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "data": {
    "values": [
      {
        "category": "A",
        "value": 28
      },
      {
        "category": "B",
        "value": 55
      },
      {
        "category": "C",
        "value": 43
      },
      {
        "category": "D",
        "value": 91
      },
      {
        "category": "E",
        "value": 81
      }
    ]
  },
  "description": "Share of total via joinaggregate + calculate.",
  "encoding": {
    "x": {
      "field": "category",
      "type": "nominal"
    },
    "y": {
      "field": "share",
      "type": "quantitative"
    }
  },
  "mark": "bar",
  "transform": [
    {
      "joinaggregate": [
        {
          "as": "total",
          "field": "value",
          "op": "sum"
        }
      ]
    },
    {
      "as": "share",
      "calculate": "datum.value / datum.total"
    }
  ],
  "usermeta": {
    "eas": {
      "standin_ratio": 0.0224,
      "threshold": 0.05
    }
  }
}
