  "description": "Price, volume and RSI(14) panes on one time axis: one crosshair and one zoom (wheel, drag, +/-) drive all three.",
  "params": [
    {
      "name": "crosshair",
      "select": {
        "encodings": ["x"],
        "nearest": true,
        "on": "pointermove",
        "type": "point"
      },
      "views": ["price-hit", "volume-hit", "rsi-hit"]
    },
    {
      "bind": "scales",
      "name": "zoom",
      "select": {
        "encodings": ["x"],
        "type": "interval"
      },
      "views": ["price-hit", "volume-hit", "rsi-hit"]
    }
  ],
  "title": "TSM daily",
  "transform": [
    {
      "sort": [
        {"field": "time"}
      ],
      "window": [
        {"as": "prev", "field": "close", "op": "lag"}
      ]
    },
    {"as": "gain", "calculate": "isValid(datum.prev) ? max(datum.close - datum.prev, 0) : 0"},
    {"as": "loss", "calculate": "isValid(datum.prev) ? max(datum.prev - datum.close, 0) : 0"},
    {
      "frame": [-13, 0],
      "sort": [
        {"field": "time"}
      ],
      "window": [
        {"as": "avg_gain", "field": "gain", "op": "mean"},
        {"as": "avg_loss", "field": "loss", "op": "mean"},
        {"as": "n", "op": "count"}
      ]
    },
    {
      "as": "rsi",
      "calculate": "datum.n < 14 ? null : datum.avg_loss == 0 ? 100 : 100 - 100 / (1 + datum.avg_gain / datum.avg_loss)"
    }
  ],
  "vconcat": [
    {
      "height": 160,
      "layer": [
        {
          "encoding": {
            "tooltip": [
              {"field": "time", "title": "date", "type": "temporal"},
              {"field": "close", "type": "quantitative"},
              {"field": "volume", "type": "quantitative"},
              {"field": "rsi", "format": ".1f", "title": "RSI(14)", "type": "quantitative"}
            ],
            "x": {"field": "time", "title": null, "type": "temporal"},
            "y": {
              "field": "close",
              "scale": {"zero": false},
              "title": "price",
              "type": "quantitative"
            }
          },
          "mark": {"type": "line"}
        },
        {
          "encoding": {
            "x": {"field": "time", "type": "temporal"}
          },
          "mark": {"opacity": 0, "type": "rule"},
          "name": "price-hit"
        },
