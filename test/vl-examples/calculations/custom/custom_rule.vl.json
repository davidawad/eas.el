{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "description": "Rule chart customization: every non-default property here is one eas draws natively (fc-qx1.43).",
  "title": {"text": "Release windows", "color": "#4a2d6b", "fontSize": 14},
  "width": 320,
  "height": 150,
  "data": {"values": [
    {"team": "api", "start": 1, "end": 4}, {"team": "web", "start": 2, "end": 7},
    {"team": "ios", "start": 5, "end": 9}, {"team": "data", "start": 3, "end": 6}
  ]},
  "mark": {"type": "rule", "size": 6, "strokeCap": "round", "opacity": 0.85, "color": "#7b4fb0"},
  "encoding": {
    "y": {"field": "team", "type": "nominal", "sort": ["api", "web", "ios", "data"],
          "axis": {"labelFontSize": 12, "labelPadding": 8, "ticks": false, "domain": false, "title": null}},
    "x": {"field": "start", "type": "quantitative", "scale": {"domain": [0, 10]},
          "axis": {"title": "Sprint", "tickCount": 5, "gridDash": [1, 3], "grid": true, "labelColor": "#4a2d6b"}},
    "x2": {"field": "end"}
  },
  "config": {"view": {"stroke": null}}
}
