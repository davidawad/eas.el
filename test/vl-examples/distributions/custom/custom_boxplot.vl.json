        "q3": 3950,
        "upper": 4800
      },
      {
        "Species": "Gentoo",
        "lower": 3950,
        "q1": 4700,
        "median": 5000,
        "q3": 5500,
        "upper": 6300
      }
    ]
  },
  "encoding": {
    "x": {
      "field": "Species",
      "type": "nominal",
      "title": null,
      "axis": {
