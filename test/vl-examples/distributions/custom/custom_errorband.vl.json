{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "description": "A mean line over a 95% confidence band, custom band and line styles.",
  "width": 340,
  "height": 200,
  "data": {
    "url": "../../data/cars.json"
  },
  "encoding": {
    "x": {
      "field": "Year",
      "timeUnit": "year",
      "axis": {
        "format": "%Y",
        "labelColor": "#555"
      }
    }
  },
  "layer": [
    {
      "mark": {
        "type": "errorband",
        "extent": "ci",
        "color": "#e7298a",
        "opacity": 0.25
      },
      "encoding": {
        "y": {
          "field": "Miles_per_Gallon",
          "type": "quantitative",
          "title": "Mean MPG (95% CI)"
        }
      }
    },
    {
      "mark": {
        "type": "line",
        "color": "#e7298a",
        "strokeWidth": 3,
        "strokeDash": [
          6,
          2
        ]
      },
      "encoding": {
        "y": {
          "aggregate": "mean",
          "field": "Miles_per_Gallon"
        }
      }
    }
  ],
  "usermeta": {
    "eas": {
      "threshold": 0.03
    }
  }
}
