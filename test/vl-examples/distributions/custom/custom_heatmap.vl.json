{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "description": "Binned heatmap with an explicit color range and axis settings.",
  "width": 320,
  "height": 200,
  "data": {
    "url": "../../data/movies.json"
  },
  "transform": [
    {
      "filter": {
        "and": [
          {
            "field": "IMDB Rating",
            "valid": true
          },
          {
            "field": "Rotten Tomatoes Rating",
            "valid": true
          }
        ]
      }
    }
  ],
  "mark": {
    "type": "rect",
    "stroke": "white"
  },
  "encoding": {
    "x": {
      "bin": {
        "maxbins": 30
      },
      "field": "IMDB Rating",
      "type": "quantitative",
      "axis": {
        "labelColor": "#444",
        "tickCount": 5
      }
    },
    "y": {
      "bin": {
        "maxbins": 20
      },
      "field": "Rotten Tomatoes Rating",
      "type": "quantitative"
    },
    "color": {
      "aggregate": "count",
      "type": "quantitative",
      "scale": {
        "range": [
          "#fff5eb",
          "#7f2704"
        ]
      },
      "legend": {
        "title": "Count"
      }
    },
    "strokeWidth": {
      "value": 1
    }
  },
  "config": {
    "view": {
      "stroke": "transparent"
    },
    "axis": {
      "domainColor": "#999",
      "labelFontSize": 10
    }
  },
  "usermeta": {
    "eas": {
      "threshold": 0.03
    }
  }
}
