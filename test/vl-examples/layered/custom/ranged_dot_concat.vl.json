{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "description": "fc-qx1.44 customization: a ranged dot plot over a multi-line text annotation, vconcat cells with their own titles and a stroked frame.",
  "spacing": 16,
  "data": {"values": [
    {"country": "China", "year": 2000, "life": 71.4}, {"country": "China", "year": 2015, "life": 76.1},
    {"country": "India", "year": 2000, "life": 62.5}, {"country": "India", "year": 2015, "life": 68.3},
    {"country": "Brazil", "year": 2000, "life": 70.1}, {"country": "Brazil", "year": 2015, "life": 75.0}
  ]},
  "vconcat": [
    {"title": {"text": "Life expectancy, 2000 to 2015", "anchor": "start", "frame": "group", "fontSize": 13, "offset": 8},
     "width": 340,
     "encoding": {
       "y": {"field": "country", "type": "nominal", "axis": {"title": null, "domain": false, "ticks": false, "labelPadding": 8}},
       "x": {"field": "life", "type": "quantitative", "scale": {"domain": [60, 80]},
             "axis": {"title": "Years", "gridDash": [2, 2], "gridColor": "#cccccc", "tickCount": 5}}
     },
     "layer": [
       {"mark": {"type": "line", "color": "#999999", "strokeWidth": 2}, "encoding": {"detail": {"field": "country"}}},
       {"mark": {"type": "point", "filled": true, "size": 70, "opacity": 1},
        "encoding": {"color": {"field": "year", "type": "ordinal", "scale": {"range": ["#e6959c", "#911a24"]},
                               "legend": {"title": null, "offset": 12}},
                     "shape": {"field": "year", "type": "ordinal", "scale": {"range": ["circle", "square"]}, "legend": null}}}
     ]},
    {"title": {"text": "Reading the chart", "anchor": "start", "frame": "bounds", "fontSize": 11, "color": "#555555"},
     "width": 340, "height": 30,
     "data": {"values": [{"x": 61, "y": 0}]},
     "mark": {"type": "text", "align": "left", "baseline": "top", "fontSize": 10, "fontStyle": "italic", "color": "#555555",
              "text": ["light: the year 2000", "dark: the year 2015"]},
     "encoding": {"x": {"field": "x", "type": "quantitative", "scale": {"domain": [60, 80]}, "axis": null},
                  "y": {"field": "y", "type": "quantitative", "axis": null}}}
  ],
  "config": {"view": {"stroke": "#dddddd"}, "title": {"color": "#222222"}}
}
