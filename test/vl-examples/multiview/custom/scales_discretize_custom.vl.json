{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "description": "Customization: quantize, quantile and threshold scales with explicit ranges, schemes, counts and legend formats.",
  "data": {"values": [
    {"a": "A", "b": 28}, {"a": "B", "b": 55}, {"a": "C", "b": 43}, {"a": "D", "b": 91}, {"a": "E", "b": 81},
    {"a": "F", "b": 53}, {"a": "G", "b": 19}, {"a": "H", "b": 87}, {"a": "I", "b": 52}, {"a": "J", "b": 64}]},
  "spacing": 30,
  "hconcat": [
    {"mark": "square",
     "encoding": {"y": {"field": "a", "type": "nominal", "axis": {"ticks": false, "domain": false, "title": null}},
                  "size": {"field": "b", "type": "quantitative", "scale": {"type": "quantize", "range": [30, 120, 210]}},
                  "color": {"field": "b", "type": "quantitative", "scale": {"type": "quantize", "range": ["#fdd0a2", "#fd8d3c", "#d94801"]},
                            "legend": {"title": "Quantize x3", "format": ".1f"}}}},
    {"mark": "circle",
     "encoding": {"y": {"field": "a", "type": "nominal", "axis": {"ticks": false, "domain": false, "title": null}},
                  "color": {"field": "b", "type": "quantitative", "scale": {"type": "quantile", "scheme": "tealblues"},
                            "legend": {"title": "Quantile", "format": "d"}}}},
    {"mark": "circle",
     "encoding": {"y": {"field": "a", "type": "nominal", "axis": {"ticks": false, "domain": false, "title": null}},
                  "size": {"field": "b", "type": "quantitative", "scale": {"type": "threshold", "domain": [40, 60, 80]}},
                  "color": {"field": "b", "type": "quantitative", "scale": {"type": "threshold", "domain": [40, 60, 80], "scheme": "plasma"},
                            "legend": {"title": "Threshold"}}}}
  ],
  "resolve": {"scale": {"color": "independent", "size": "independent"}},
  "config": {"scale": {"quantileCount": 4}}
}
